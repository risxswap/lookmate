# 由官方 Nginx 镜像启动脚本仅替换 LOOKMATE_SERVER_UPSTREAM。
map $http_x_forwarded_proto $lookmate_forwarded_proto {
    default http;
    https https;
}

map $http_x_forwarded_port $lookmate_forwarded_port {
    default 80;
    443 443;
    ~^[0-9]+$ $http_x_forwarded_port;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 2m;

    # Docker 嵌入 DNS；变量代理在后端容器重建后重新解析地址。
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;
    set $lookmate_api http://${LOOKMATE_SERVER_UPSTREAM};

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location ~ ^/api(?:/|$) {
        proxy_pass $lookmate_api$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $lookmate_forwarded_proto;
        proxy_set_header X-Forwarded-Port $lookmate_forwarded_port;
        # 宿主机入口已覆盖为真实客户端地址，此处不追加容器网关地址。
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Real-IP $http_x_forwarded_for;
        proxy_set_header Forwarded "";
        proxy_intercept_errors off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 240s;
        proxy_send_timeout 60s;
        proxy_next_upstream off;
        add_header Cache-Control "no-store" always;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

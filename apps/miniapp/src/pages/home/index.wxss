.home-page {
  padding: 6rpx 34rpx calc(40rpx + env(safe-area-inset-bottom));
}

.home-heading {
  margin-bottom: 26rpx;
}

.home-heading-row,
.home-section-heading,
.daily-caption,
.other-plan {
  display: flex;
  align-items: center;
}

.home-date {
  display: inline-block;
  vertical-align: top;
}

.date-picker {
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: 44px;
  color: var(--lm-muted);
  font-size: 13px;
}

.date-label {
  color: var(--lm-primary);
  font-size: 14px;
  font-weight: 550;
}

.date-chevron {
  width: 6px;
  height: 6px;
  box-sizing: border-box;
  border-right: 1.4px solid currentColor;
  border-bottom: 1.4px solid currentColor;
  transform: translateY(-2px) rotate(45deg);
}

.home-heading-row,
.home-section-heading,
.daily-caption {
  justify-content: space-between;
  gap: 16rpx;
}

.home-title,
.home-section-title,
.empty-look-title {
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", serif;
  font-weight: 600;
  line-height: 1.4;
}

.home-title,
.home-section-title {
  font-size: 21px;
  letter-spacing: -0.6px;
}

.design-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-height: 36px;
  padding: 5px 12px;
  border-radius: 24px;
  color: var(--lm-primary);
  background: var(--lm-soft);
  white-space: nowrap;
  font-size: 13px;
  font-weight: 550;
}

.design-icon {
  width: 15px;
  height: 15px;
}

.task-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--lm-primary);
}

.pill-chevron {
  width: 12px;
  height: 12px;
}

.t-button.retry-button {
  padding-top: 12rpx;
  color: inherit;
  font-size: 24rpx;
}

.home-loading {
  padding: 60rpx 24rpx;
  text-align: center;
  color: var(--lm-muted);
  font-size: 26rpx;
}

.daily-look {
  overflow: hidden;
  border-radius: 32rpx;
  border: 1rpx solid var(--lm-border);
  background: var(--lm-surface);
}

.daily-image-wrap {
  position: relative;
  display: flex;
  gap: 4rpx;
  height: 380rpx;
  background: var(--lm-image-background);
}

.daily-detail,
.daily-full-image {
  min-width: 0;
  height: 100%;
}

.daily-detail {
  flex: 1;
  overflow: hidden;
}

.daily-detail-image {
  width: 100%;
  height: 100%;
  transform: scale(2.5);
  transform-origin: 54% 33%;
}

.daily-full-image {
  width: 51%;
}

.daily-placeholder {
  width: 100%;
}

.daily-tag {
  position: absolute;
  top: 22rpx;
  left: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: var(--lm-surface);
  color: var(--lm-primary);
  font-size: 22rpx;
}

.daily-caption {
  padding: 18rpx 26rpx 22rpx;
}

.daily-caption-copy,
.other-plan-copy {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}

.daily-name {
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.4;
}

.daily-scene,
.daily-note,
.source-missing,
.outfit-description,
.empty-look-state {
  margin-top: 4rpx;
  color: var(--lm-muted);
  font-size: 24rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.daily-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid var(--lm-border);
  border-radius: 50%;
  flex-shrink: 0;
}

.home-icon {
  width: 32rpx;
  height: 32rpx;
}

.empty-look {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 300rpx;
  border: 0;
  background: #edeee4;
}

.empty-look-copy {
  box-sizing: border-box;
  width: 53.5%;
  padding: 28rpx;
}

.empty-look-state {
  margin: 0 0 8rpx;
}

.empty-look-title {
  font-size: 46rpx;
}

.empty-look-link {
  margin-top: 22rpx;
  color: var(--lm-primary);
  font-size: 28rpx;
  font-weight: 600;
}

.empty-look-link text {
  margin-left: 6rpx;
}

.editorial-image {
  position: absolute;
  top: 0;
  right: 0;
  width: 46.5%;
  height: 100%;
}

.other-plans {
  margin-top: 12rpx;
}

.other-plan {
  gap: 18rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--lm-border);
}

.other-plan-image {
  width: 90rpx;
  height: 112rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: var(--lm-image-background);
}

.other-plan-title,
.outfit-name {
  font-size: 28rpx;
  font-weight: 550;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.t-button.all-plans-button,
.t-button.view-all-button {
  color: var(--lm-muted);
  font-size: 24rpx;
}

.all-plans-button-content,
.view-all-button-content {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.small-chevron {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

.home-section-heading {
  margin: 36rpx 0 12rpx;
}

.outfits-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
}

.outfit-tile {
  min-width: 0;
}

.outfit-frame {
  position: relative;
  width: 100%;
  height: 0;
  padding-top: 133.333%;
  overflow: hidden;
  border-radius: 20rpx;
  background: var(--lm-image-background);
}

.outfit-photo {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.placeholder-icon {
  width: 50rpx;
  height: 50rpx;
}

.outfit-name {
  margin-top: 12rpx;
}

.pinned-label {
  margin-right: 8rpx;
  color: var(--lm-primary);
  font-size: 22rpx;
}

.outfits-empty {
  padding: 34rpx 28rpx;
  border-radius: 24rpx;
  background: var(--lm-surface);
  text-align: center;
}

.outfits-empty-title {
  font-size: 28rpx;
}

.outfits-empty-description {
  margin: 10rpx 0 20rpx;
  color: var(--lm-muted);
  font-size: 24rpx;
}

<t-navbar t-class="lm-tab-navbar" title="Lookmate" fixed placeholder animation="{{false}}"/>
<view class="page home-page">
  <view class="home-heading">
    <picker class="home-date" disabled="{{busy}}" mode="date" value="{{date}}" bindchange="changeDate" aria-label="选择穿搭日期，当前为{{dateLabel}}{{weekdayLabel}}">
      <view class="date-picker">
        <text class="date-label">{{dateLabel}}</text>
        <text>{{weekdayLabel}}</text>
        <view class="date-chevron" aria-hidden="true"/>
      </view>
    </picker>
    <view class="home-heading-row">
      <view class="home-title">我的穿搭</view>
      <t-button wx:if="{{active}}" t-class="lm-custom-root design-entry" variant="text" hover-class="tap-feedback" bind:tap="task" aria-label="查看进度，{{active.title || '设计任务'}}，{{statusLabel[active.status] || active.status}}">
        <view class="lm-custom-content design-pill"><view class="task-dot"/><text>查看进度</text><image src="/assets/icons/chevron-right.png" class="pill-chevron" mode="aspectFit"/></view>
      </t-button>
      <t-button wx:else t-class="lm-custom-root design-entry" variant="text" hover-class="tap-feedback" bind:tap="design" aria-label="去做设计">
        <view class="lm-custom-content design-pill"><image src="/assets/icons/design-active.png" class="design-icon" mode="aspectFit"/><text>去做设计</text></view>
      </t-button>
    </view>
  </view>

  <view wx:if="{{error}}" class="error">
    <view>{{error}}</view>
    <t-button t-class="lm-custom-root retry-button" variant="text" hover-class="tap-feedback" bind:tap="refresh" disabled="{{busy}}"><view class="lm-custom-content retry-button-content">重新加载</view></t-button>
  </view>
  <view wx:if="{{busy && !loaded}}" class="home-loading">正在加载这一天的穿搭…</view>

  <block wx:if="{{loaded}}">
    <view wx:if="{{planImageWarning}}" class="error">部分安排图片加载失败，下拉刷新重试</view>
    <view wx:if="{{plans.length}}" class="daily-look" bindtap="calendar" aria-role="button" aria-label="查看当天穿搭安排">
      <view class="daily-image-wrap">
        <block wx:if="{{plans[0].cover}}">
          <view class="daily-detail">
            <image class="daily-detail-image" src="{{plans[0].cover}}" mode="aspectFill" data-id="{{plans[0].id}}" data-cover="{{plans[0].cover}}" binderror="planImageError"/>
          </view>
          <image class="daily-full-image" src="{{plans[0].cover}}" mode="aspectFit" data-id="{{plans[0].id}}" data-cover="{{plans[0].cover}}" binderror="planImageError"/>
        </block>
        <view wx:else class="daily-placeholder image-placeholder">
          <image src="/assets/icons/image.png" class="placeholder-icon" mode="aspectFit"/>
          <text>暂无搭配图片</text>
        </view>
        <view class="daily-tag">{{isToday ? '今日穿搭' : '当日穿搭'}}</view>
      </view>
      <view class="daily-caption">
        <view class="daily-caption-copy">
          <view class="daily-name">{{plans[0].outfit ? plans[0].outfit.name : '尚未选择搭配'}}</view>
          <view class="daily-scene">{{plans[0].scene}}</view>
          <view wx:if="{{plans[0].note}}" class="daily-note">{{plans[0].note}}</view>
          <view wx:if="{{plans[0].sourceMissing}}" class="source-missing">原搭配已删除，安排快照仍保留</view>
        </view>
        <view class="daily-arrow"><image src="/assets/icons/arrow-up-right.png" class="home-icon" mode="aspectFit"/></view>
      </view>
    </view>
    <view wx:else class="daily-look empty-look" bindtap="calendar" aria-role="button" aria-label="为这一天安排搭配">
      <view class="empty-look-copy">
        <view class="empty-look-state">{{isToday ? '今天还没有安排' : '这一天还没有安排'}}</view>
        <view class="empty-look-title">{{isToday ? '今天穿什么？' : '这天穿什么？'}}</view>
        <view class="empty-look-link">安排搭配 <text>→</text></view>
      </view>
      <image class="editorial-image" src="/assets/editorial.jpg" mode="aspectFill"/>
    </view>

    <view wx:if="{{plans.length > 1}}" class="other-plans">
      <block wx:for="{{plans}}" wx:key="id">
        <view wx:if="{{index > 0}}" class="other-plan" bindtap="calendar" aria-role="button">
          <image wx:if="{{item.cover}}" class="other-plan-image" src="{{item.cover}}" mode="aspectFill" data-id="{{item.id}}" data-cover="{{item.cover}}" binderror="planImageError"/>
          <view wx:else class="other-plan-image image-placeholder"><image src="/assets/icons/image.png" class="home-icon" mode="aspectFit"/></view>
          <view class="other-plan-copy">
            <view class="other-plan-title">{{item.scene}} · {{item.outfit ? item.outfit.name : '尚未选择搭配'}}</view>
            <view wx:if="{{item.note}}" class="daily-note">{{item.note}}</view>
            <view wx:if="{{item.sourceMissing}}" class="source-missing">原搭配已删除，安排快照仍保留</view>
          </view>
          <image src="/assets/icons/chevron-right.png" class="small-chevron" mode="aspectFit"/>
        </view>
      </block>
    </view>
    <t-button t-class="lm-custom-root all-plans-button" variant="text" hover-class="tap-feedback" wx:if="{{planTotal > plans.length}}" bind:tap="calendar"><view class="lm-custom-content all-plans-button-content">查看当天全部 {{planTotal}} 套安排<image src="/assets/icons/chevron-right.png" class="small-chevron" mode="aspectFit"/></view></t-button>
  </block>

  <view class="home-section-heading">
    <view class="home-section-title">常用搭配</view>
    <t-button t-class="lm-custom-root view-all-button" variant="text" hover-class="tap-feedback" data-url="/pages/outfits/index" bind:tap="go"><view class="lm-custom-content view-all-button-content">查看全部<image src="/assets/icons/chevron-right.png" class="small-chevron" mode="aspectFit"/></view></t-button>
  </view>
  <view wx:if="{{outfitImageWarning}}" class="error">{{outfitImageWarning}}</view>
  <view wx:if="{{loaded && !outfits.length}}" class="outfits-empty">
    <view class="outfits-empty-title">把喜欢的衣物组合起来</view>
    <view class="outfits-empty-description">保存常穿搭配，下次出门更轻松</view>
    <t-button class="lm-button lm-button--outline lm-button--compact" t-class="lm-button__root" theme="default" variant="outline" size="small" block data-url="/pages/outfit-detail/index" bind:tap="go">创建第一套搭配</t-button>
  </view>
  <view class="outfits-grid">
    <view wx:for="{{outfits}}" wx:key="id" class="outfit-tile" data-url="/pages/outfit-detail/index?id={{item.id}}" bindtap="go" aria-role="button" aria-label="查看{{item.name}}">
      <view class="outfit-frame">
        <image wx:if="{{item.cover}}" class="outfit-photo" src="{{item.cover}}" mode="aspectFill" data-id="{{item.id}}" data-file-id="{{item.sourceOutputFileId || item.items[0].imageFileIds[0]}}" data-cover="{{item.cover}}" binderror="outfitImageError"/>
        <view wx:else class="outfit-photo image-placeholder"><image src="/assets/icons/image.png" class="placeholder-icon" mode="aspectFit"/><text>暂无搭配图片</text></view>
      </view>
      <view class="outfit-name"><text wx:if="{{item.pinned}}" class="pinned-label">置顶</text>{{item.name}}</view>
      <view wx:if="{{item.scenesText}}" class="outfit-description">{{item.scenesText}}</view>
    </view>
  </view>
</view>

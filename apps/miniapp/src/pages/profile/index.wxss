.profile-editor {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.profile-editor--save-error {
  padding-bottom: calc(300rpx + env(safe-area-inset-bottom));
}

.profile-avatar-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--lm-soft);
}

.profile-avatar {
  display: block;
  flex: 0 0 168rpx;
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  background: var(--lm-surface);
}

.profile-avatar--default {
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-avatar-icon {
  width: 72rpx;
  height: 72rpx;
}

.profile-avatar-body {
  flex: 1;
  min-width: 0;
}

.profile-avatar-title {
  margin-bottom: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.profile-avatar-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx 8rpx;
}

.profile-compact-button {
  width: auto;
  margin: 0;
  --lm-button-padding-vertical: 12rpx;
  --lm-button-padding-horizontal: 17rpx;
  --td-button-default-bg-color: var(--lm-surface);
  --td-button-default-border-color: var(--lm-surface);
}

.profile-section {
  padding: 30rpx;
}

.profile-section .section-title {
  margin-bottom: 20rpx;
}

.profile-field + .profile-field {
  margin-top: 24rpx;
}

.profile-field .label {
  margin: 0 0 10rpx;
}

.profile-optional {
  margin-left: 6rpx;
  color: var(--lm-muted);
  font-size: 24rpx;
  font-weight: 400;
}

.profile-input,
.profile-note,
.profile-date-field {
  background: var(--lm-background);
}

.profile-input,
.profile-note {
  padding: 18rpx 20rpx;
  font-size: 28rpx;
}

.profile-note {
  display: block;
  min-height: 148rpx;
  height: 148rpx;
}

.profile-date-field {
  display: flex;
  align-items: center;
  border: 2rpx solid var(--lm-border);
  border-radius: 20rpx;
}

.profile-date-picker {
  flex: 1;
  min-width: 0;
}

.profile-date-trigger {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 44px;
  gap: 14rpx;
  padding: 14rpx 18rpx;
  font-size: 28rpx;
}

.profile-date-icon {
  width: 30rpx;
  height: 30rpx;
}

.profile-date-chevron {
  width: 23rpx;
  height: 23rpx;
  margin-left: auto;
}

.profile-date-placeholder {
  color: var(--lm-muted);
}

.profile-date-pressed {
  opacity: .7;
}

.profile-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.profile-option {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  gap: 8rpx;
  min-height: 44px;
  max-width: 100%;
  padding: 10rpx 17rpx;
  border: 2rpx solid var(--lm-border);
  border-radius: 24rpx;
  background: var(--lm-surface);
  color: var(--lm-text);
  font-size: 26rpx;
}

.profile-option--selected {
  border-color: var(--lm-primary);
  background: var(--lm-soft);
  color: var(--lm-primary);
  font-weight: 500;
}

.profile-option radio,
.profile-option checkbox {
  display: flex;
  flex: 0 0 30rpx;
  justify-content: center;
  width: 30rpx;
  margin: 0;
  transform: scale(.65);
}

.profile-inline-error {
  margin-top: 10rpx;
  color: var(--lm-error);
  font-size: 25rpx;
  line-height: 1.5;
}

.profile-retry {
  width: auto;
  margin: 12rpx 0 0;
}

.profile-save-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 5;
  padding: 18rpx 40rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--lm-border);
  background: var(--lm-surface);
}

.profile-save-error {
  max-height: 110rpx;
  margin: 0 0 12rpx;
  overflow-y: auto;
  overflow-wrap: anywhere;
}

.profile-save-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.profile-conflict-reload {
  width: auto;
  margin: 0;
}

.profile-save-button {
  flex: 1;
  margin: 0;
}

.avatar-crop-overlay {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 22rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));
  background: rgba(22, 29, 23, .62);
}

.avatar-crop-panel {
  box-sizing: border-box;
  width: 100%;
  max-width: 400px;
  padding: 28rpx;
  border-radius: 28rpx;
  background: var(--lm-surface);
}

.avatar-crop-title {
  text-align: center;
}

.avatar-crop-stage {
  position: relative;
  z-index: 0;
  width: min(100%, 320px, calc(100vh - 188px));
  min-width: 120px;
  aspect-ratio: 1;
  overflow: hidden;
  margin: 0 auto;
  border-radius: 18rpx;
  background: var(--lm-soft);
}

.avatar-crop-canvas,
.avatar-crop-touch,
.avatar-crop-loading {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.avatar-crop-canvas {
  z-index: 0;
}

.avatar-crop-touch {
  z-index: 1;
  touch-action: none;
}

.avatar-crop-loading {
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--lm-muted);
  font-size: 26rpx;
}

.avatar-crop-controls {
  margin-top: 18rpx;
  color: var(--lm-muted);
  font-size: 26rpx;
  text-align: center;
}

.avatar-crop-slider {
  margin: 0 8rpx;
  padding: 12rpx 0;
}

.avatar-crop-error {
  max-height: 80rpx;
  margin: 0 0 12rpx;
  overflow-y: auto;
}

.avatar-crop-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.avatar-crop-actions .lm-button {
  margin: 0;
}

@media (max-width: 350px) {
  .profile-editor,
  .profile-save-bar {
    padding-left: 28rpx;
    padding-right: 28rpx;
  }

  .profile-avatar-card,
  .profile-section {
    padding: 24rpx;
  }
}

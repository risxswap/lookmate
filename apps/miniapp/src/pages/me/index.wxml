<view class="page me-page">
  <view wx:if="{{error}}" class="error">
    <view>{{error}}</view>
    <t-button t-class="lm-custom-root retry-button" variant="text" hover-class="tap-feedback" bind:tap="load" disabled="{{busy}}"><view class="lm-custom-content retry-button-content">重新加载</view></t-button>
  </view>
  <view wx:if="{{busy && !account}}" class="profile-loading">正在加载个人资料…</view>

  <t-button t-class="lm-custom-root profile-heading" variant="text" block hover-class="tap-feedback" data-url="/pages/profile/index" bind:tap="go" aria-label="编辑个人资料"><view class="lm-custom-content profile-heading-content">
    <image wx:if="{{avatar}}" class="avatar" src="{{avatar}}" mode="aspectFill" binderror="avatarError"/>
    <view wx:else class="avatar avatar-placeholder"><image src="/assets/icons/user.png" class="avatar-icon" mode="aspectFit"/></view>
    <view class="profile-copy">
      <view class="profile-name">{{account.displayName || account.username || '微信用户'}}</view>
      <view class="profile-edit">编辑个人资料与偏好</view>
    </view>
    <image src="/assets/icons/chevron-right.png" class="entry-chevron" mode="aspectFit"/>
  </view></t-button>

  <view class="profile-shortcuts">
    <t-button t-class="lm-custom-root shortcut" variant="text" block hover-class="tap-feedback" data-url="/pages/records/index" bind:tap="go"><view class="lm-custom-content shortcut-content">
      <image src="/assets/icons/history.png" class="shortcut-icon" mode="aspectFit"/>
      <text>设计记录</text>
    </view></t-button>
    <t-button t-class="lm-custom-root shortcut" variant="text" block hover-class="tap-feedback" data-url="/pages/favorites/index" bind:tap="go"><view class="lm-custom-content shortcut-content">
      <image src="/assets/icons/heart.png" class="shortcut-icon" mode="aspectFit"/>
      <text>我的收藏</text>
    </view></t-button>
  </view>

  <view class="me-section-title">关于我</view>
  <view class="profile-menu">
    <t-button t-class="lm-custom-root profile-entry" variant="text" block hover-class="tap-feedback" data-url="/pages/profile/index" bind:tap="go"><view class="lm-custom-content profile-entry-content">
      <image src="/assets/icons/user.png" class="entry-icon" mode="aspectFit"/>
      <text class="entry-label">基础资料与偏好</text>
      <image src="/assets/icons/chevron-right.png" class="entry-chevron" mode="aspectFit"/>
    </view></t-button>
    <t-button t-class="lm-custom-root profile-entry" variant="text" block hover-class="tap-feedback" data-url="/pages/photos/index" bind:tap="go"><view class="lm-custom-content profile-entry-content">
      <image src="/assets/icons/camera.png" class="entry-icon" mode="aspectFit"/>
      <text class="entry-label">个人照片</text>
      <image src="/assets/icons/chevron-right.png" class="entry-chevron" mode="aspectFit"/>
    </view></t-button>
    <t-button t-class="lm-custom-root profile-entry" variant="text" block hover-class="tap-feedback" data-url="/pages/measurements/index" bind:tap="go"><view class="lm-custom-content profile-entry-content">
      <image src="/assets/icons/ruler.png" class="entry-icon" mode="aspectFit"/>
      <text class="entry-label">身体尺寸与历史</text>
      <image src="/assets/icons/chevron-right.png" class="entry-chevron" mode="aspectFit"/>
    </view></t-button>
  </view>

  <view class="me-section-title">我的日常</view>
  <view class="profile-menu">
    <t-button t-class="lm-custom-root profile-entry" variant="text" block hover-class="tap-feedback" data-url="/pages/calendar/index" bind:tap="go"><view class="lm-custom-content profile-entry-content">
      <image src="/assets/icons/calendar.png" class="entry-icon" mode="aspectFit"/>
      <text class="entry-label">穿搭日历</text>
      <image src="/assets/icons/chevron-right.png" class="entry-chevron" mode="aspectFit"/>
    </view></t-button>
    <view class="profile-entry account-state">
      <image src="/assets/icons/shield.png" class="entry-icon" mode="aspectFit"/>
      <text class="entry-label">微信账号</text>
      <text class="entry-note">{{account ? (account.wechatBound ? '已绑定' : '未绑定') : '加载中'}}</text>
    </view>
    <t-button t-class="lm-custom-root profile-entry" variant="text" block hover-class="tap-feedback" wx:if="{{account.hasPassword}}" disabled="{{busy}}" data-url="/pages/change-password/index" bind:tap="go"><view class="lm-custom-content profile-entry-content">
      <image src="/assets/icons/shield.png" class="entry-icon" mode="aspectFit"/>
      <text class="entry-label">修改密码</text>
      <image src="/assets/icons/chevron-right.png" class="entry-chevron" mode="aspectFit"/>
    </view></t-button>
  </view>
</view>

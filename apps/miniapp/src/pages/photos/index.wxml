<view class="page">
  <view wx:if="{{error}}" class="error">{{error}}<view class="link" bindtap="load">重新加载</view>
  </view>
  <view class="title">个人照片</view>
  <view class="muted">用于 AI 设计，与账号头像分开。无需一次填满。</view>
  <view class="grid photo-grid">
    <view wx:for="{{rows}}" wx:key="key" class="card photo-card">
      <view class="photo-heading">
        <text class="photo-label">{{item.name}}</text>
        <t-button wx:if="{{item.photo}}" class="photo-menu" t-class="lm-custom-root photo-menu__root" variant="text" block aria-label="{{item.name}}的更多操作" data-id="{{item.key}}" bind:tap="photoMenu" disabled="{{busy}}">
          <text aria-hidden="true">···</text>
        </t-button>
      </view>
      <t-button wx:if="{{item.photo}}" t-class="lm-custom-root" variant="text" block aria-label="预览{{item.name}}" data-id="{{item.key}}" bind:tap="preview" disabled="{{busy}}">
        <image wx:if="{{item.url}}" class="photo photo-frame" src="{{item.url}}" mode="aspectFill" data-id="{{item.key}}" data-url="{{item.url}}" binderror="thumbnailError" aria-hidden="true"/>
        <view wx:else class="photo-frame photo-placeholder">
          <text>缩略图加载失败</text>
          <text class="photo-action-label">查看原图</text>
        </view>
      </t-button>
      <t-button wx:else t-class="lm-custom-root" variant="text" block aria-label="添加{{item.name}}" data-id="{{item.key}}" bind:tap="upload" disabled="{{busy}}">
        <view class="photo-frame photo-placeholder photo-empty">
          <text class="photo-add-icon" aria-hidden="true">＋</text>
          <text class="photo-action-label">添加照片</text>
        </view>
      </t-button>
    </view>
  </view>
  <view wx:if="{{legacy.length}}" class="card">
    <view class="section-title">旧版未分类照片</view>
    <view class="muted">旧照片仍占用容量，可归入空照片位或删除。</view>
    <view wx:for="{{legacy}}" wx:key="id">
      <picker range="{{angleNames}}" data-id="{{item.id}}" bindchange="assign">
        <view class="input">将旧照片 {{index+1}} 归位 ›</view>
      </picker>
      <t-button class="lm-button" t-class="lm-button__root" theme="default" variant="base" size="medium" block data-id="{{item.id}}" bind:tap="remove">删除旧照片 {{index+1}}</t-button>
    </view>
  </view>
</view>

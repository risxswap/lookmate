<view class="page"><view class="row between"><view class="title">常用搭配</view><t-button size="small" theme="primary" data-url="/pages/outfit-detail/index" bindtap="go">新建搭配</t-button></view>
 <scroll-view scroll-x class="tabs"><view class="tab {{!groupId?'active':''}}" data-id="" bindtap="filter">全部</view><view wx:for="{{groups}}" wx:key="id" class="tab {{groupId===item.id?'active':''}}" data-id="{{item.id}}" bindtap="filter">{{item.name}}</view></scroll-view>
 <view class="row"><input disabled="{{busy}}" class="input grow" placeholder="按场景筛选，如通勤" maxlength="20" value="{{scene}}" bindinput="scene"/><t-button size="small" bindtap="applyScene">筛选</t-button></view>
 <view wx:if="{{error}}" class="error" bindtap="more">{{error}} · 重试</view><view class="muted">共 {{total}} 套</view>
 <view wx:if="{{!busy && !items.length}}" class="empty">还没有符合条件的搭配</view>
 <view class="grid"><view wx:for="{{items}}" wx:key="id" class="card outfit" data-url="/pages/outfit-detail/index?id={{item.id}}" bindtap="go"><image wx:if="{{item.cover}}" class="photo" src="{{item.cover}}" mode="aspectFill"/><view>{{item.pinned?'置顶 · ':''}}{{item.name}}</view><view class="muted">{{item.scenesText}}</view><view class="muted">{{item.itemsText}}</view></view></view>
 <t-button wx:if="{{more}}" variant="text" loading="{{busy}}" bindtap="more">加载更多搭配</t-button>
 <view class="card"><view class="section-title">整理分组</view><view wx:for="{{groups}}" wx:key="id" class="row between"><text class="grow">{{item.name}}</text><text class="link" data-id="{{item.id}}" bindtap="editGroup">改名</text><text class="link" data-id="{{item.id}}" bindtap="deleteGroup">删除</text></view><t-button wx:if="{{groupMore}}" variant="text" bindtap="moreGroups">更多分组</t-button><input disabled="{{busy}}" class="input" value="{{groupName}}" bindinput="groupName" maxlength="50" placeholder="分组名称"/><view class="actions"><t-button loading="{{busy}}" bindtap="saveGroup">{{editGroupId?'保存改名':'创建分组'}}</t-button><t-button wx:if="{{editGroupId}}" variant="text" bindtap="cancelGroup">取消</t-button></view></view>
</view>

<view class="page"><view class="page-header"><view class="title">常用搭配</view><t-button class="lm-button lm-button--primary lm-button--compact" t-class="lm-button__root" theme="primary" variant="base" size="small" block data-url="/pages/outfit-detail/index" bind:tap="go">新建搭配</t-button></view>
 <scroll-view scroll-x class="tabs"><view class="tab {{!groupId?'active':''}}" data-id="" bindtap="filter">全部</view><view wx:for="{{groups}}" wx:key="id" class="tab {{groupId===item.id?'active':''}}" data-id="{{item.id}}" bindtap="filter">{{item.name}}</view></scroll-view>
 <view class="row filter-row"><input disabled="{{busy}}" class="input grow" placeholder="按场景筛选，如通勤" maxlength="20" value="{{scene}}" bindinput="scene"/><t-button class="lm-button lm-button--compact" t-class="lm-button__root" theme="default" variant="base" size="small" block bind:tap="applyScene">筛选</t-button></view>
 <view wx:if="{{error}}" class="error" bindtap="more">{{error}} · 重试</view><view class="muted">共 {{total}} 套</view>
 <view wx:if="{{imageWarning}}" class="error">{{imageWarning}}</view>
 <view wx:if="{{!busy && !items.length}}" class="empty">还没有符合条件的搭配</view>
 <view class="grid"><view wx:for="{{items}}" wx:key="id" class="card outfit" data-url="/pages/outfit-detail/index?id={{item.id}}" bindtap="go"><image wx:if="{{item.cover}}" class="photo" src="{{item.cover}}" mode="aspectFill" lazy-load data-id="{{item.id}}" data-file-id="{{item.sourceOutputFileId || item.items[0].imageFileIds[0]}}" data-cover="{{item.cover}}" binderror="imageError"/><view wx:else class="photo image-placeholder">暂无图片</view><view>{{item.pinned?'置顶 · ':''}}{{item.name}}</view><view class="muted">{{item.scenesText}}</view><view class="muted">{{item.itemsText}}</view></view></view>
 <t-button class="lm-button lm-button--text" t-class="lm-button__root" theme="default" variant="text" size="medium" block wx:if="{{more}}" loading="{{busy}}" bind:tap="more" disabled="{{busy}}">加载更多搭配</t-button>
 <view class="card"><view class="section-title">整理分组</view><view wx:for="{{groups}}" wx:key="id" class="row between"><text class="grow">{{item.name}}</text><text class="link" data-id="{{item.id}}" bindtap="editGroup">改名</text><text class="link" data-id="{{item.id}}" bindtap="deleteGroup">删除</text></view><t-button class="lm-button lm-button--text" t-class="lm-button__root" theme="default" variant="text" size="medium" block wx:if="{{groupMore}}" bind:tap="moreGroups">更多分组</t-button><input disabled="{{busy}}" class="input" value="{{groupName}}" bindinput="groupName" maxlength="50" placeholder="分组名称"/><view class="actions"><t-button class="lm-button lm-button--primary" t-class="lm-button__root" theme="primary" variant="base" size="large" block loading="{{busy}}" bind:tap="saveGroup" disabled="{{busy}}">{{editGroupId?'保存改名':'创建分组'}}</t-button><t-button class="lm-button lm-button--text" t-class="lm-button__root" theme="default" variant="text" size="medium" block wx:if="{{editGroupId}}" bind:tap="cancelGroup">取消</t-button></view></view>
</view>

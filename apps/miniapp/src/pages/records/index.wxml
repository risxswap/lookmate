<view class="page">
  <view wx:if="{{error}}" class="error">{{error}}<view class="link" bindtap="load">重新加载</view>
  </view>
  <view class="title">设计记录</view>
  <view class="tabs">
    <view class="tab {{scope==='all'?'active':''}}" data-key="scope" data-id="all" bindtap="filter">全部任务</view>
    <view class="tab {{scope==='design'?'active':''}}" data-key="scope" data-id="design" bindtap="filter">仅设计</view>
  </view>
  <view class="tabs">
    <view wx:for="{{types}}" wx:key="id" class="tab {{designType===item.id?'active':''}}" data-key="designType" data-id="{{item.id}}" bindtap="filter">{{item.name}}</view>
  </view>
  <picker range="{{statuses}}" range-key="name" bindchange="status">
    <view class="input">状态筛选 · {{status || '全部'}}</view>
  </picker>
  <view class="muted">共 {{total}} 条</view>
  <view wx:if="{{!items.length && !busy}}" class="empty">还没有符合条件的记录。</view>
  <view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open">
    <view class="row between">
      <view class="subtitle">{{item.title || '设计任务'}}</view>
      <view class="pill">{{item.statusText}}</view>
    </view>
    <view>{{item.summary || item.errorMessage}}</view>
    <view class="muted">{{item.createdAt}} {{item.outfitId?'· 常用搭配任务':''}}</view>
  </view>
  <t-button wx:if="{{hasMore}}" bind:tap="more" loading="{{busy}}">加载更多</t-button>
</view>

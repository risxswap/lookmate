<view class="page wardrobe-page">
  <view class="wardrobe-heading-row">
    <view class="wardrobe-heading">我的衣橱</view>
    <t-button t-class="lm-custom-root wardrobe-add" variant="text" hover-class="tap-feedback" wx:if="{{section==='clothes'}}" bind:tap="newDress" aria-label="添加衣物"><view class="lm-custom-content wardrobe-add-content"><image class="wardrobe-icon" src="/assets/icons/plus.png"/></view></t-button>
    <t-button t-class="lm-custom-root wardrobe-add" variant="text" hover-class="tap-feedback" wx:else data-url="/pages/outfit-detail/index" bind:tap="go" aria-label="新建搭配"><view class="lm-custom-content wardrobe-add-content"><image class="wardrobe-icon" src="/assets/icons/plus.png"/></view></t-button>
  </view>
  <view class="wardrobe-segments">
    <t-button t-class="lm-custom-root wardrobe-segment {{section==='clothes'?'is-selected':''}}" variant="text" hover-class="tap-feedback" bind:tap="clothes" disabled="{{busy}}"><view class="lm-custom-content wardrobe-segment-content">衣物</view></t-button>
    <t-button t-class="lm-custom-root wardrobe-segment {{section==='outfits'?'is-selected':''}}" variant="text" hover-class="tap-feedback" bind:tap="outfits" disabled="{{busy}}"><view class="lm-custom-content wardrobe-segment-content">常用搭配</view></t-button>
  </view>

  <view wx:if="{{imageWarning}}" class="error">{{imageWarning}}</view>
  <block wx:if="{{section==='clothes'}}">
    <scroll-view class="wardrobe-categories" scroll-x show-scrollbar="{{false}}">
      <view class="wardrobe-category-track">
        <t-button t-class="lm-custom-root wardrobe-category {{!categoryId?'is-selected':''}}" variant="text" hover-class="tap-feedback" data-id="" bind:tap="chooseCategory" disabled="{{busy}}"><view class="lm-custom-content wardrobe-category-content">全部</view></t-button>
        <t-button t-class="lm-custom-root wardrobe-category {{categoryId===item.id?'is-selected':''}}" variant="text" hover-class="tap-feedback" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bind:tap="chooseCategory" disabled="{{busy}}"><view class="lm-custom-content wardrobe-category-content">{{item.name}}</view></t-button>
      </view>
    </scroll-view>
    <view class="wardrobe-list-meta"><text>共 {{total}} 件衣物{{busy?' · 加载中':''}}</text><text>最近添加</text></view>
    <view wx:if="{{error}}" class="error">{{error}}<view class="link" bindtap="load">重新加载</view></view>
    <view wx:if="{{!items.length && !busy && !error}}" class="wardrobe-empty">
      <image class="wardrobe-empty-icon" src="/assets/icons/image.png"/>
      <view>{{categoryId?'这个分类还没有衣物':'给喜欢的衣物，留一个位置'}}</view>
      <view class="muted">添加衣物，开始搭配自己的衣橱。</view>
      <t-button class="lm-button lm-button--primary" t-class="lm-button__root" theme="primary" variant="base" size="large" block bind:tap="newDress">添加衣物</t-button>
    </view>
    <view class="wardrobe-grid">
      <t-button t-class="lm-custom-root wardrobe-item" variant="text" block hover-class="none" wx:for="{{items}}" wx:key="id" data-url="/pages/dress-edit/index?id={{item.id}}" bind:tap="go"><view class="lm-custom-content wardrobe-item-content">
        <image wx:if="{{item.cover}}" class="wardrobe-photo" src="{{item.cover}}" mode="aspectFill" lazy-load data-id="{{item.id}}" data-cover="{{item.cover}}" data-file-id="{{item.images[0].fileId}}" data-kind="items" binderror="imageError"/>
        <view wx:else class="image-placeholder wardrobe-photo"><image class="wardrobe-empty-icon" src="/assets/icons/image.png"/><text>暂无图片</text></view>
        <view class="wardrobe-item-name">{{item.name}}</view>
        <view class="wardrobe-item-meta">{{item.color || ''}}{{item.color && item.categoryName?' · ':''}}{{item.categoryName}}</view>
      </view></t-button>
    </view>
  </block>
  <block wx:else>
    <view class="wardrobe-list-meta"><text>共 {{total}} 套搭配{{busy?' · 加载中':''}}</text><t-button t-class="lm-custom-root wardrobe-manage" variant="text" hover-class="tap-feedback" data-url="/pages/outfits/index" bind:tap="go"><view class="lm-custom-content wardrobe-manage-content">筛选与分组<image class="wardrobe-small-icon" src="/assets/icons/chevron-right.png"/></view></t-button></view>
    <view wx:if="{{error}}" class="error">{{error}}<view class="link" bindtap="load">重新加载</view></view>
    <view wx:if="{{!outfits.length && !busy && !error}}" class="wardrobe-empty">
      <image class="wardrobe-empty-icon" src="/assets/icons/image.png"/>
      <view>把喜欢的组合，留给日常</view>
      <view class="muted">将衣物组合保存，下次出门更轻松。</view>
      <t-button class="lm-button lm-button--primary" t-class="lm-button__root" theme="primary" variant="base" size="large" block data-url="/pages/outfit-detail/index" bind:tap="go">新建搭配</t-button>
    </view>
    <view class="wardrobe-grid">
      <t-button t-class="lm-custom-root wardrobe-item" variant="text" block hover-class="none" wx:for="{{outfits}}" wx:key="id" data-url="/pages/outfit-detail/index?id={{item.id}}" bind:tap="go"><view class="lm-custom-content wardrobe-item-content">
        <view class="wardrobe-picture">
          <image wx:if="{{item.cover}}" class="wardrobe-photo" src="{{item.cover}}" mode="aspectFill" lazy-load data-id="{{item.id}}" data-cover="{{item.cover}}" data-file-id="{{item.sourceOutputFileId || item.items[0].imageFileIds[0]}}" data-kind="outfits" binderror="imageError"/>
          <view wx:else class="image-placeholder wardrobe-photo"><image class="wardrobe-empty-icon" src="/assets/icons/image.png"/><text>暂无图片</text></view>
          <view wx:if="{{item.pinned}}" class="wardrobe-pinned">置顶</view>
        </view>
        <view class="wardrobe-item-name">{{item.name}}</view>
        <view class="wardrobe-item-meta">{{item.items.length}} 件衣物{{item.scenesText?' · ':''}}{{item.scenesText}}</view>
      </view></t-button>
    </view>
  </block>
  <t-button class="lm-button lm-button--text" t-class="lm-button__root" theme="default" variant="text" size="medium" block wx:if="{{hasMore}}" bind:tap="more" loading="{{busy}}" disabled="{{busy}}">加载更多</t-button>
</view>

.page.wardrobe-page {
  padding: 2px 34rpx calc(40rpx + env(safe-area-inset-bottom));
}

.wardrobe-toolbar,
.wardrobe-segments,
.wardrobe-list-meta,
.wardrobe-manage-content,
.wardrobe-pill {
  display: flex;
  align-items: center;
}

.wardrobe-toolbar,
.wardrobe-list-meta {
  justify-content: space-between;
  gap: 8px;
}

.wardrobe-segments {
  gap: 12px;
}

.wardrobe-segments,
.wardrobe-category-track {
  --td-button-default-disabled-bg: transparent;
  --td-button-default-disabled-color: var(--lm-muted);
}

.t-button.wardrobe-segment {
  position: relative;
  min-width: 44px;
  color: var(--lm-muted);
  font-size: 17px;
  text-align: center;
  white-space: nowrap;
}

.t-button.wardrobe-segment.is-selected {
  color: var(--lm-text);
  font-weight: 600;
}

.wardrobe-segment.is-selected::before {
  content: "";
  position: absolute;
  bottom: 2px;
  left: 50%;
  width: 18px;
  height: 3px;
  transform: translateX(-50%);
  border-radius: 2px;
  background: var(--lm-primary);
}

.wardrobe-pill {
  box-sizing: border-box;
  justify-content: center;
  gap: 4px;
  min-height: 32px;
  padding: 4px 12px;
  border-radius: 24px;
  color: var(--lm-primary);
  background: var(--lm-soft);
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
}

.wardrobe-icon {
  width: 14px;
  height: 14px;
  flex: none;
}

.wardrobe-categories {
  width: 100%;
  margin-top: 6px;
  white-space: nowrap;
}

.wardrobe-category-track {
  display: inline-flex;
  align-items: center;
  gap: 2px;
}

.t-button.wardrobe-category {
  min-width: 44px;
  text-align: center;
  white-space: nowrap;
}

.wardrobe-category-label {
  box-sizing: border-box;
  min-width: 44px;
  padding: 5px 10px;
  border-radius: 22px;
  color: var(--lm-text);
  font-size: 14px;
  line-height: 20px;
}

.is-selected .wardrobe-category-label {
  color: var(--lm-primary);
  background: var(--lm-soft);
  font-weight: 600;
}

.wardrobe-list-meta {
  margin: 6px 0 10px;
  color: var(--lm-muted);
  font-size: 12px;
  line-height: 1.5;
}

.t-button.wardrobe-manage,
.t-button.wardrobe-retry {
  min-width: 44px;
  color: var(--lm-primary);
  font-size: 13px;
}

.wardrobe-manage-content {
  gap: 3px;
  white-space: nowrap;
}

.wardrobe-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: start;
  gap: 14px 11px;
}

.t-button.wardrobe-item {
  display: block;
  width: 100%;
  text-align: left;
}

.wardrobe-picture {
  position: relative;
  height: 0;
  padding-top: 100%;
  overflow: hidden;
  border-radius: 12px;
  background: var(--lm-image-background);
}

.wardrobe-picture--outfit {
  padding-top: 133.333%;
}

.wardrobe-photo {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.wardrobe-cover-parts {
  display: flex;
  gap: 2px;
}

.wardrobe-cover-part {
  flex: 1 1 0;
  min-width: 0;
  height: 100%;
}

.wardrobe-item-name,
.wardrobe-item-meta {
  word-break: break-all;
  line-height: 1.5;
}

.wardrobe-item-name {
  margin-top: 6px;
  color: var(--lm-text);
  font-size: 15px;
  font-weight: 600;
}

.wardrobe-item-meta {
  margin-top: 1px;
  color: var(--lm-muted);
  font-size: 12px;
}

.wardrobe-pinned {
  position: absolute;
  top: 6px;
  left: 6px;
  padding: 2px 7px;
  border-radius: 8px;
  color: var(--lm-primary);
  background: var(--lm-surface);
  font-size: 12px;
}

.wardrobe-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 30px 6px;
  color: var(--lm-muted);
  font-size: 15px;
  text-align: center;
}

.wardrobe-empty-icon {
  width: 26px;
  height: 26px;
}

.measurement-field + .measurement-field {
  margin-top: 12rpx;
}

.measurement-field-heading,
.measurement-guide-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.measurement-field-heading {
  font-size: 28rpx;
  font-weight: 500;
}

.measurement-help {
  flex-shrink: 0;
}

.t-button.measurement-help__button {
  width: 100rpx;
  min-width: 44px;
  min-height: 44px;
  margin: 0;
  padding: 0;
  justify-content: flex-end;
}

.measurement-guide {
  box-sizing: border-box;
  padding: 16rpx 32rpx 20rpx;
  border-radius: 28rpx 28rpx 0 0;
  overflow: hidden;
  background: var(--lm-surface);
  color: var(--lm-text);
}

.measurement-guide--illustrated {
  display: flex;
  flex-direction: column;
  height: 65vh;
  max-height: 660rpx;
}

.measurement-guide-header {
  flex-shrink: 0;
  border-bottom: 1rpx solid var(--lm-border);
  padding-bottom: 12rpx;
}

.measurement-guide-title {
  font-size: 36rpx;
  font-weight: 600;
}

.measurement-guide-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.measurement-guide-hint {
  padding: 16rpx 0;
  font-size: 28rpx;
}

.measurement-guide-image {
  display: block;
  width: 100%;
  height: 440rpx;
  max-height: 42vh;
  border-radius: 16rpx;
  background: var(--lm-background);
}

.measurement-guide-hint--text {
  padding-bottom: 4rpx;
}

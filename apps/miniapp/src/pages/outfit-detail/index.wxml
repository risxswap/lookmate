<view class="page"><view class="title">{{outfitId?'我的常用搭配':'组合一套搭配'}}</view><view class="muted">从自己的衣橱挑选单品，保存日常喜欢的组合。</view>
 <view wx:if="{{error}}" class="error">{{error}}<view class="link" bindtap="refresh">刷新服务端数据（会覆盖未保存编辑）</view></view>
 <view class="card"><view class="label">搭配名称</view><input disabled="{{busy}}" class="input" data-field="name" value="{{name}}" bindinput="field" maxlength="100" placeholder="如：周五的轻松通勤"/><view class="label">搭配笔记</view><textarea disabled="{{busy}}" class="textarea" data-field="note" value="{{note}}" bindinput="field" maxlength="2000" placeholder="穿法、配色，或想记住的细节"/>
 <view class="row between"><text>置顶，方便下次找到</text><switch disabled="{{busy}}" checked="{{pinned}}" color="#315c50" bindchange="pin"/></view>
 <view class="label">适用场景</view><input disabled="{{busy}}" class="input" data-field="scenes" value="{{scenes}}" bindinput="field" maxlength="420" placeholder="通勤、日常、约会（用顿号分隔）"/>
 <view class="label">分组 · 已选 {{groupIds.length}} 个</view><t-button variant="outline" bindtap="chooseGroups">{{showGroups?'收起分组':'选择分组'}}</t-button><view wx:if="{{showGroups}}"><view class="chips"><view wx:for="{{groups}}" wx:key="id" class="pill {{item.selected?'chosen':''}}" data-id="{{item.id}}" bindtap="toggleGroup">{{item.selected?'✓ ':''}}{{item.name}}</view></view><view wx:if="{{!groups.length}}" class="empty">还没有分组，可到常用搭配页创建。</view><t-button wx:if="{{groupMore}}" variant="text" bindtap="moreGroups">更多分组</t-button></view>
 </view>
 <view class="card"><view class="row between"><view class="section-title">搭配单品 · {{dressIds.length}}</view><view class="link" bindtap="chooseDresses">{{showDresses?'收起衣橱':'从衣橱选择'}}</view></view>
  <view wx:for="{{selectedItems}}" wx:key="id" class="row selected"><image wx:if="{{item.cover}}" class="thumb" src="{{item.cover}}" mode="aspectFill"/><view class="grow">{{item.name}}<view wx:if="{{item.missing}}" class="error">原衣物已删除，保留历史快照</view></view><text class="link" data-id="{{item.id}}" bindtap="toggleDress">移除</text></view>
  <view wx:if="{{!selectedItems.length}}" class="empty">至少选择一件衣物</view>
  <view wx:if="{{showDresses}}"><view class="grid"><view wx:for="{{dresses}}" wx:key="id" class="choice {{item.selected?'chosen':''}}" data-id="{{item.id}}" bindtap="toggleDress"><image wx:if="{{item.cover}}" class="photo" src="{{item.cover}}" mode="aspectFill"/><text>{{item.selected?'✓ ':''}}{{item.name}}</text></view></view><view wx:if="{{!dresses.length}}" class="empty">衣橱中还没有衣物，请先到衣橱添加。</view><t-button wx:if="{{dressMore}}" bindtap="moreDresses">加载更多衣物</t-button></view>
 </view>
 <t-button theme="primary" block loading="{{busy}}" bindtap="save">保存搭配</t-button>
 <view wx:if="{{outfitId}}" class="actions"><t-button variant="outline" bindtap="calendar">安排到日历</t-button><t-button variant="text" theme="danger" bindtap="remove">删除搭配</t-button></view>
 <view wx:if="{{outfitId}}" class="card"><view class="section-title">让搭配更适合你</view><view class="muted">AI 使用已保存的搭配；修改单品或笔记后请先保存。</view><view class="actions"><t-button disabled="{{pending}}" loading="{{busy}}" data-kind="EVALUATION" bindtap="generate">AI 文字评价</t-button><t-button variant="outline" bindtap="choosePhotos">选择本人全身照</t-button></view>
  <view wx:if="{{showPhotos}}"><view class="grid"><view wx:for="{{photos}}" wx:key="id" class="choice {{item.selected?'chosen':''}}" data-id="{{item.fileId}}" bindtap="selectPhoto"><image class="photo" src="{{item.cover}}" mode="aspectFill"/><text>{{item.selected?'✓ 已选择':'选择这张全身照'}}</text></view></view><view wx:if="{{!photos.length}}" class="empty">暂无全身照，可在“我的 → 本人照片”添加。</view><t-button wx:if="{{photoMore}}" variant="text" bindtap="morePhotos">加载更多照片</t-button></view>
  <t-button theme="primary" disabled="{{pending || !personFileId}}" loading="{{busy}}" data-kind="IMAGE" bindtap="generate">生成穿搭效果图</t-button>
  <view wx:if="{{pending}}" class="error">有一笔提交结果待确认。恢复只查询原任务。<view class="actions"><t-button bindtap="recover">找回任务</t-button><t-button wx:if="{{canResend}}" variant="outline" bindtap="resend">原键重发</t-button></view></view>
 </view>
 <view wx:if="{{selectedJob}}" class="card"><view class="row between"><view class="section-title">{{selectedJob.kind==='IMAGE'?'穿搭效果':'搭配评价'}}</view><text class="pill">{{statusLabel[selectedJob.status]}}</text></view>
  <view wx:if="{{selectedJob.stale}}" class="error">这是修改前的搭配结果，当前搭配已更新。</view>
  <image wx:if="{{jobImage}}" class="result-image" src="{{jobImage}}" mode="widthFix" bindtap="preview"/><t-button wx:if="{{jobImage}}" variant="outline" bindtap="saveImage">保存图片到相册</t-button>
  <view wx:if="{{selectedJob.errorMessage}}" class="error">{{selectedJob.errorMessage}}</view>
  <view wx:if="{{selectedJob.result}}"><view class="section-title">{{selectedJob.result.title}}</view><view>{{selectedJob.result.summary}}</view><view class="label">搭配思路</view><view>{{selectedJob.result.designReason}}</view><view wx:if="{{selectedJob.result.colorAdvice}}" class="label">配色建议</view><view>{{selectedJob.result.colorAdvice}}</view><view wx:if="{{selectedJob.result.wearingAdvice}}" class="label">穿法建议</view><view>{{selectedJob.result.wearingAdvice}}</view><view wx:for="{{selectedJob.result.notices}}" wx:key="code" class="muted">{{item.message}}</view><view wx:if="{{selectedJob.result.illustrativeShoes}}" class="muted">示意鞋：{{selectedJob.result.illustrativeShoes.description}}</view><view wx:for="{{selectedJob.result.items}}" wx:key="dressId" class="selected"><view class="label">{{item.dressName}}</view><view>{{item.matchReason}}</view><view class="muted">{{item.wearingMethod}}</view></view></view>
  <view class="actions"><t-button wx:if="{{retryFull}}" disabled="{{pending}}" data-mode="FULL" bindtap="retry">重新尝试</t-button><t-button wx:if="{{retryImage}}" disabled="{{pending}}" data-mode="IMAGE_ONLY" bindtap="retry">重试效果图</t-button><t-button variant="text" bindtap="refresh">刷新状态</t-button></view>
 </view>
 <view wx:if="{{outfitId}}" class="card"><view class="section-title">AI 历史记录</view><view wx:for="{{jobs}}" wx:key="taskId" class="selected" data-id="{{item.taskId}}" bindtap="selectJob"><view class="row between"><text>{{item.kind==='IMAGE'?'效果图':'文字评价'}} · {{item.label}}</text><text>→</text></view><view class="muted">{{item.createdAt}} {{item.stale?'· 历史版本':''}}</view></view><view wx:if="{{!jobs.length}}" class="empty">还没有 AI 记录</view><t-button wx:if="{{jobMore}}" variant="text" bindtap="moreJobs">加载更多记录</t-button></view>
</view>

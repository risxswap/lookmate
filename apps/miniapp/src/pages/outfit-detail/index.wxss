.outfit-page {
  word-break: break-word;
}

.page.outfit-view {
  padding: 6px 34rpx calc(28px + env(safe-area-inset-bottom));
}

.detail-header,
.detail-heading,
.meta-line {
  display: flex;
  align-items: center;
}

.detail-header,
.detail-heading {
  justify-content: space-between;
  gap: 12px;
}

.outfit-name {
  flex: 1;
  min-width: 0;
  font-size: 23px;
  font-weight: 600;
  line-height: 1.35;
  word-break: break-all;
}

.edit-action {
  --td-button-default-disabled-bg: transparent;
}

.edit-chip {
  min-width: 44px;
  padding: 6px 12px;
  box-sizing: border-box;
  border-radius: 22px;
  background: var(--lm-soft);
  color: var(--lm-primary);
  font-size: 13px;
  font-weight: 600;
  text-align: center;
  white-space: nowrap;
}

.group-choices {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.meta-scroll {
  width: 100%;
}

.meta-line {
  display: inline-flex;
  min-height: 24px;
  gap: 8px;
  color: var(--lm-muted);
  white-space: nowrap;
  font-size: 13px;
}

.pinned {
  padding: 2px 8px;
  border-radius: 5px;
  background: var(--lm-soft);
  color: var(--lm-primary);
  font-size: 12px;
}

.scene + .scene::before {
  content: "·";
  margin-right: 8px;
}

.hero-panel {
  margin-top: 10px;
}

.t-button.hero-button,
.t-button.tile-button,
.t-button.history-button {
  display: block;
  overflow: hidden;
  text-align: left;
}

.t-button.hero-button,
.hero-frame,
.collage,
.history-image {
  border-radius: 14px;
}

.current-hero {
  width: 100%;
  max-width: 54vh;
  margin: 0 auto;
}

.hero-frame {
  position: relative;
  height: 0;
  padding-top: 133.333%;
  overflow: hidden;
  background: var(--lm-image-background);
}

.hero-image,
.hero-placeholder {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-placeholder .lm-button {
  width: auto;
  margin: 4rpx 0;
}

.collage {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-template-rows: minmax(0, 1fr);
  height: 62vw;
  max-height: 50vh;
  gap: 3px;
  overflow: hidden;
  background: var(--lm-background);
}

.collage-1 {
  grid-template-columns: minmax(0, 1fr);
}

.collage-3,
.collage-4 {
  grid-template-rows: repeat(2, minmax(0, 1fr));
  height: 76vw;
}

.collage-3 .collage-cell:first-child {
  grid-row: span 2;
}

.collage-cell {
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  background: var(--lm-image-background);
}

.collage-hit,
.t-button.collage-preview,
.collage-preview .t-button__content,
.collage-image {
  display: block;
  width: 100%;
  height: 100%;
}

.collage-missing {
  box-sizing: border-box;
  padding: 12rpx;
  display: flex;
}

.missing-name {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.collage-empty {
  display: flex;
  height: 240rpx;
  background: var(--lm-image-background);
}

.hero-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 8px;
  margin-top: 8px;
}

.hero-actions .lm-button,
.generate-hero.lm-button {
  margin: 0;
  --td-button-border-radius: 12px;
}

.generate-hero.lm-button {
  margin-top: 8px;
}

.save-hero {
  --td-button-default-color: var(--lm-primary);
  --td-button-default-border-color: var(--lm-soft);
}

.hero-panel + .muted {
  margin-top: 8px;
}

.hero-progress,
.task-status {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: var(--lm-soft);
  color: var(--lm-primary);
  font-size: 26rpx;
}

.detail-section {
  margin-top: 22px;
}

.outfit-view .section-title {
  margin: 0;
  font-size: 18px;
  line-height: 1.5;
}

.detail-heading {
  margin-bottom: 10px;
}

.item-count,
.item-meta,
.item-missing {
  color: var(--lm-muted);
  font-size: 12px;
  line-height: 1.5;
}

.count {
  margin-left: 14rpx;
  color: var(--lm-muted);
  font-size: 24rpx;
  font-weight: 400;
}

.items-scroll {
  width: 100%;
}

.items-track {
  display: inline-flex;
  width: max-content;
  gap: 10px;
  padding-bottom: 2px;
}

.item-tile {
  width: 32vw;
  flex: none;
  min-width: 0;
}

.item-image,
.picked-thumb {
  background: var(--lm-image-background);
  border-radius: 16rpx;
}

.item-image {
  width: 100%;
  height: 32vw;
  border-radius: 10px;
}

.item-name {
  margin-top: 6px;
  font-size: 15px;
  font-weight: 600;
  line-height: 1.5;
  white-space: normal;
  word-break: break-all;
}

.item-meta,
.item-missing {
  margin-top: 2px;
  white-space: normal;
  word-break: break-all;
}

.wear-section {
  margin: 20px 0;
  border-top: 1px solid var(--lm-border);
}

.note-section {
  padding: 16px 0 8px;
}

.note-section .body-copy {
  margin-top: 7px;
  font-size: 15px;
}

.body-copy {
  line-height: 1.75;
  white-space: pre-wrap;
  overflow-wrap: break-word;
}

.calendar-action {
  display: block;
}

.calendar-label {
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: 44px;
  color: var(--lm-primary);
  font-size: 14px;
  font-weight: 500;
}

.calendar-label .calendar-chevron {
  width: 12px;
  height: 12px;
  margin-left: auto;
}

.calendar-label image,
.history-chevron {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.advice-card .section-header,
.edit-section .section-header {
  margin-bottom: 12rpx;
}

.advice-card {
  padding: 12px 15px 15px;
  border-radius: 14px;
}

.advice-card .section-header .lm-button {
  --lm-button-padding-horizontal: 0;
}

.advice-summary {
  font-size: 15px;
}

.advice-card .advice-toggle {
  width: fit-content;
  max-width: 100%;
  margin: 2px 0 0;
  --lm-button-padding-horizontal: 0;
}

.history-chevron.is-open {
  transform: rotate(90deg);
}

.detail-label {
  margin: 22rpx 0 8rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.history,
.source-history,
.history-row {
  border-top: 1rpx solid var(--lm-border);
}

.history-row,
.picked-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 88rpx;
  padding: 16rpx 0;
}

.history-meta {
  margin-top: 4rpx;
  color: var(--lm-muted);
  font-size: 24rpx;
}

.history-detail {
  padding: 8rpx 0 24rpx;
}

.history-image {
  display: block;
  width: 100%;
  background: var(--lm-image-background);
}

.advice-card > .lm-button:last-child,
.photo-panel > .lm-button:last-child {
  margin-bottom: 0;
}

.photo-panel {
  margin-top: 20rpx;
}

.selection-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.selection-grid:not(:empty) {
  margin: 18rpx 0;
}

.pick-tile {
  overflow: hidden;
  border: 3rpx solid var(--lm-border);
  border-radius: 18rpx;
}

.pick-tile.is-selected {
  border-color: var(--lm-primary);
  background: var(--lm-soft);
}

.tile-image {
  width: 100%;
  height: 220rpx;
  background: var(--lm-image-background);
}

.photo-choice {
  height: 300rpx;
}

.tile-label {
  padding: 12rpx;
  font-size: 26rpx;
  word-break: break-all;
}

.edit-section .label:first-child {
  margin-top: 0;
}

.edit-setting {
  padding-top: 18rpx;
}

.group-choices .lm-button,
.picked-row .lm-button {
  flex: 0 0 auto;
  width: auto;
  max-width: 100%;
  margin: 0;
}

.picked-row + .picked-row {
  border-top: 1rpx solid var(--lm-border);
}

.picked-thumb {
  flex: 0 0 90rpx;
  width: 90rpx;
  height: 100rpx;
}

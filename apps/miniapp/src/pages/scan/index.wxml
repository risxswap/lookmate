<view class="page"><view class="title">登录 Lookmate 网页版</view><view class="card"><view class="section-title">{{accountName}}</view><view wx:if="{{error}}" class="error">{{error}}</view><block wx:if="{{status === 'PENDING'}}"><view class="muted">请确认这是你正在使用的网页。登录码剩余 {{seconds}} 秒。</view><t-button theme="primary" block disabled="{{busy || !seconds}}" loading="{{busy}}" data-action="confirm" bind:tap="act">确认登录</t-button><t-button block variant="outline" disabled="{{busy}}" data-action="cancel" bind:tap="act">取消</t-button></block><view wx:elif="{{status === 'CONFIRMED' || status === 'CONSUMED'}}">已确认，请返回网页继续使用。</view><view wx:elif="{{status === 'CANCELLED'}}">已取消登录，请在网页刷新后重新扫码。</view><view wx:elif="{{status === 'EXPIRED'}}">登录码已过期，请在网页刷新后重新扫码。已完成的注册或绑定仍然保留。</view><t-button wx:if="{{error}}" block variant="outline" disabled="{{busy}}" bind:tap="load">重新检查</t-button><t-button block variant="text" bind:tap="home">返回小程序首页</t-button></view></view>

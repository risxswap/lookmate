<view class="page"><view class="row between"><view class="title">穿搭日历</view><t-button size="small" theme="primary" bindtap="newPlan">添加安排</t-button></view>
 <picker disabled="{{busy}}" mode="date" value="{{date}}" bindchange="changeDate"><view class="date">{{date}} ▾</view></picker><view class="muted">本月有安排的日期 · 一天可以安排多套</view><scroll-view scroll-x class="tabs"><view wx:for="{{days}}" wx:key="date" class="tab {{date===item.date?'active':''}}" data-id="{{item.date}}" bindtap="selectDay">{{item.label}} · {{item.count}} 套</view></scroll-view>
 <view wx:if="{{error}}" class="error">{{error}}<text class="link" bindtap="refresh"> · 刷新重试</text></view><view wx:if="{{pending}}" class="card"><view>上一次创建安排的结果尚未确认。</view><t-button loading="{{busy}}" bindtap="resend">使用原请求恢复安排</t-button></view>
 <view wx:if="{{editing}}" class="card"><view class="section-title">{{editId?'编辑安排':'新安排'}}</view><view class="label">日期</view><picker disabled="{{busy}}" mode="date" value="{{editDate}}" data-field="editDate" bindchange="field"><view class="input">{{editDate}} ▾</view></picker><view class="label">场景</view><input disabled="{{busy}}" class="input" data-field="scene" value="{{scene}}" bindinput="field" maxlength="20" placeholder="如：上午通勤、晚间聚会"/><view class="label">备注</view><textarea disabled="{{busy}}" class="textarea" data-field="note" value="{{note}}" bindinput="field" maxlength="80" placeholder="选填，最多 80 字"/><view class="label">搭配</view><view class="row between"><text>{{outfitName}}</text><text class="link" bindtap="chooseOutfits">选择搭配</text></view>
  <view wx:if="{{showOutfits}}"><view class="pill" data-id="" bindtap="selectOutfit">暂不选择，稍后再安排</view><view wx:for="{{outfits}}" wx:key="id" class="row outfit" data-id="{{item.id}}" bindtap="selectOutfit"><image wx:if="{{item.cover}}" class="thumb" src="{{item.cover}}" mode="aspectFill"/><view class="grow">{{item.name}}<view class="muted">{{item.scenesText}}</view></view><text>{{outfitId===item.id?'✓':'选择'}}</text></view><t-button wx:if="{{outfitMore}}" variant="text" bindtap="moreOutfits">更多常用搭配</t-button></view>
  <view class="actions"><t-button theme="primary" loading="{{busy}}" disabled="{{pending && !editId}}" bindtap="save">保存安排</t-button><t-button variant="text" bindtap="cancel">取消编辑</t-button></view>
 </view>
 <view class="section-title">当天安排 · {{total}} 套</view><view wx:if="{{!busy && !plans.length}}" class="empty">这一天还没有安排</view>
 <view wx:for="{{plans}}" wx:key="id" class="card"><view class="row between"><view class="section-title">{{item.scene}}</view><text class="muted">{{item.date}}</text></view><view>{{item.outfit ? item.outfit.name : '尚未选择搭配'}}</view><view class="muted">{{item.note}}</view><view wx:if="{{item.sourceMissing}}" class="error">原搭配已删除，以下保留当时的穿搭快照。</view><view wx:for="{{item.outfit.items}}" wx:for-item="dress" wx:key="dressId" class="snapshot"><text>{{dress.dressName}}</text><text class="muted"> · {{dress.categoryName}} {{dress.color || ''}}</text></view><view wx:if="{{item.outfit.note}}" class="muted">{{item.outfit.note}}</view><view class="actions"><t-button size="small" variant="outline" data-id="{{item.id}}" bindtap="edit">编辑</t-button><t-button size="small" variant="text" theme="danger" data-id="{{item.id}}" bindtap="remove">删除</t-button></view></view>
 <t-button wx:if="{{more}}" variant="text" loading="{{busy}}" bindtap="more">加载更多安排</t-button>
</view>

.page.design-page {
  padding-top: 20rpx;
  padding-right: 32rpx;
  padding-left: 32rpx;
}

.design-segments {
  display: flex;
  padding: 6rpx;
  margin-bottom: 24rpx;
  border-radius: 22rpx;
  background: var(--lm-soft);
}

.t-button.design-segment {
  flex: 1;
  border-radius: 16rpx;
  color: var(--lm-muted);
  font-size: 28rpx;
  line-height: 1.5;
  text-align: center;
}

.t-button.design-segment.is-selected {
  color: var(--lm-text);
  background: var(--lm-surface);
  font-weight: 600;
}

.design-start.lm-button {
  margin: 0;
}

.design-start-note {
  margin-top: 16rpx;
  padding: 0 24rpx;
  color: var(--lm-muted);
  font-size: 28rpx;
  line-height: 1.5;
  text-align: center;
}

.design-overall-example {
  margin-top: 24rpx;
}

.design-overall-example-image {
  display: block;
  width: 100%;
  border-radius: 24rpx;
  background: var(--lm-image-background);
}

.design-overall-example-caption {
  margin-top: 12rpx;
  color: var(--lm-muted);
  font-size: 28rpx;
  line-height: 1.5;
  text-align: center;
}

.design-start-root .t-button__content {
  flex: 1;
  text-align: left;
  font-weight: 600;
}

.design-action-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.design-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 24rpx;
  margin-bottom: 14rpx;
}

.design-section-title {
  min-width: 0;
  font-size: 34rpx;
  font-weight: 600;
}

.design-tools {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 12rpx;
}

.t-button.design-collection,
.t-button.design-filter-trigger {
  color: var(--lm-text);
  font-size: 26rpx;
  line-height: 1.5;
}

.design-small-icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.t-button.design-filter-trigger {
  padding: 0 18rpx;
  border: 1rpx solid var(--lm-border);
  border-radius: 44rpx;
}

.t-button.design-collection {
  padding: 0 4rpx;
  color: var(--lm-muted);
}

.t-button.design-collection.is-selected {
  color: var(--lm-primary);
  font-weight: 600;
}

.t-button.design-filter-trigger.is-selected {
  background: var(--lm-soft);
  border-color: var(--lm-soft);
}

.design-filter-summary {
  margin-bottom: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--lm-muted);
  overflow-wrap: anywhere;
}

.design-filters {
  margin-bottom: 28rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--lm-surface);
}

.design-filter-pickers {
  display: flex;
  flex-direction: column;
}

.design-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  font-size: 27rpx;
  gap: 16rpx;
}

.design-picker-label {
  color: var(--lm-muted);
}

.design-filters .lm-button {
  display: block;
  margin-top: 24rpx;
}

.design-list-meta {
  font-size: 23rpx;
  color: var(--lm-muted);
  margin: 14rpx 0;
}

.design-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx 18rpx;
}

.t-button.design-reference {
  display: block;
  overflow: hidden;
  border-radius: 24rpx;
  background: var(--lm-image-background);
  text-align: center;
  line-height: 1.5;
}

.design-picture {
  position: relative;
}

.design-photo {
  display: flex;
  width: 100%;
  height: 334rpx;
  background: var(--lm-soft);
}

.design-grid--outfit .design-photo {
  height: 396rpx;
}

.design-saved {
  position: absolute;
  right: 14rpx;
  bottom: 14rpx;
  display: flex;
  padding: 10rpx;
  background: var(--lm-surface);
  border-radius: 50%;
}

.design-reference-caption {
  padding: 12rpx 10rpx;
}

.design-reference-name {
  font-size: 27rpx;
  font-weight: 500;
  overflow-wrap: anywhere;
}

.design-reference-meta {
  margin-top: 2rpx;
  color: var(--lm-muted);
  font-size: 23rpx;
}

.design-empty {
  padding: 24rpx 20rpx;
  border-radius: 20rpx;
  background: var(--lm-surface);
  color: var(--lm-text);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.5;
  text-align: center;
}

.design-empty-note {
  margin-top: 6rpx;
  color: var(--lm-muted);
  font-weight: 400;
}

.design-empty-icon {
  width: 48rpx;
  height: 48rpx;
  margin: 0 auto 16rpx;
  opacity: .7;
}

.design-detail {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  z-index: 10;
  background: var(--lm-background);
}

.design-detail-header {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 36rpx;
  background: var(--lm-background);
}

.design-detail-scroll {
  flex: 1;
  width: 100%;
  height: 0;
  min-height: 0;
}

.design-detail-title {
  min-width: 0;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.5;
  word-break: break-all;
}

.t-button.design-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  margin: 0;
  padding: 0;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--lm-soft);
}

.design-detail-content {
  padding: 0 36rpx 24rpx;
}

.design-detail-photo {
  display: block;
  width: 100%;
  margin-bottom: 24rpx;
  border-radius: 28rpx;
  background: var(--lm-soft);
}

.design-detail-missing {
  min-height: 360rpx;
  margin-bottom: 24rpx;
}

.design-detail-section {
  margin: 28rpx 0;
  color: var(--lm-muted);
  font-size: 28rpx;
  line-height: 1.8;
}

.design-detail-section-title {
  margin-bottom: 10rpx;
  color: var(--lm-text);
  font-weight: 600;
}

.design-unavailable {
  background: var(--lm-soft);
  padding: 24rpx;
  border-radius: 20rpx;
  font-size: 27rpx;
  line-height: 1.7;
}

.design-detail-actions {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 16rpx 36rpx 12rpx;
  background: var(--lm-background);
}

.design-detail-actions .lm-button {
  flex: auto;
  min-width: 0;
  margin: 0;
}

.design-tool-content,
.design-close-content {
  display: flex;
  align-items: center;
}

.design-tool-content {
  justify-content: center;
  gap: 8rpx;
}

.design-close-content {
  justify-content: center;
}

.design-page {
  padding-top: 28rpx;
}

.design-heading {
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: -1rpx;
}

.design-segments {
  display: flex;
  padding: 8rpx;
  margin: 34rpx 0;
  border-radius: 22rpx;
  background: var(--lm-soft);
}

.design-segment {
  flex: 1;
  min-width: 0;
  padding: 20rpx 6rpx;
  margin: 0;
  border-radius: 16rpx;
  color: var(--lm-muted);
  background: transparent;
  font-size: 25rpx;
  line-height: 1.5;
}

.design-segment::after,
.design-start::after,
.design-collection::after,
.design-filter-trigger::after,
.design-reference::after,
.design-close::after {
  border: 0;
}

.design-segment.is-selected {
  color: var(--lm-text);
  background: var(--lm-surface);
}

.design-intro {
  padding: 36rpx;
  margin-bottom: 40rpx;
  border-radius: 36rpx;
  background: var(--lm-soft);
}

.design-intro-title {
  font-size: 39rpx;
  font-weight: 600;
  line-height: 1.45;
}

.design-intro-copy {
  color: var(--lm-muted);
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.7;
}

.design-start {
  display: inline-flex;
  align-items: center;
  gap: 36rpx;
  min-height: 88rpx;
  padding: 20rpx 30rpx;
  margin: 28rpx 0 0;
  border-radius: 20rpx;
  background: var(--lm-primary);
  color: var(--lm-surface);
  font-size: 27rpx;
  line-height: 1.6;
}

.design-action-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.design-section-head,
.design-filter-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.design-section-title {
  font-size: 35rpx;
  font-weight: 600;
}

.design-collection {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 0 16rpx 12rpx;
  margin: 0;
  background: transparent;
  color: var(--lm-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.design-collection.is-selected {
  color: var(--lm-primary);
  font-weight: 600;
}

.design-small-icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.design-filter-line {
  justify-content: flex-start;
  margin: 15rpx 0 18rpx;
}

.design-filter-trigger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 80rpx;
  margin: 0;
  padding: 15rpx 22rpx;
  flex-shrink: 0;
  border: 1rpx solid var(--lm-border);
  border-radius: 44rpx;
  background: transparent;
  font-size: 25rpx;
  line-height: 1.5;
}

.design-filter-trigger.is-selected {
  background: var(--lm-soft);
  border-color: var(--lm-soft);
}

.design-filter-summary {
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--lm-muted);
  word-break: break-all;
}

.design-filters {
  margin-bottom: 28rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--lm-surface);
}

.design-filter-pickers {
  display: flex;
  flex-direction: column;
}

.design-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  font-size: 27rpx;
  gap: 16rpx;
}

.design-picker-label {
  color: var(--lm-muted);
}

.design-filters t-button {
  display: block;
  margin-top: 24rpx;
}

.design-list-meta {
  font-size: 23rpx;
  color: var(--lm-muted);
  margin-bottom: 24rpx;
}

.design-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 32rpx 24rpx;
  margin-bottom: 24rpx;
}

.design-reference {
  display: block;
  margin: 0;
  padding: 0;
  min-width: 0;
  background: transparent;
  text-align: left;
  border-radius: 0;
  line-height: 1.5;
}

.design-picture {
  position: relative;
}

.design-photo {
  display: flex;
  width: 100%;
  height: 396rpx;
  border-radius: 26rpx;
  background: var(--lm-soft);
}

.design-saved {
  position: absolute;
  right: 14rpx;
  bottom: 14rpx;
  padding: 13rpx;
  background: var(--lm-surface);
  border-radius: 50%;
}

.design-reference-name {
  margin-top: 16rpx;
  font-size: 27rpx;
  font-weight: 500;
  word-break: break-all;
}

.design-reference-meta {
  margin-top: 6rpx;
  color: var(--lm-muted);
  font-size: 23rpx;
}

.design-empty {
  padding: 68rpx 16rpx;
  text-align: center;
  font-size: 28rpx;
  line-height: 1.8;
}

.design-empty-icon {
  width: 48rpx;
  height: 48rpx;
  margin: 0 auto 16rpx;
  opacity: .7;
}

.design-detail {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  height: 100%;
  z-index: 10;
  background: var(--lm-background);
}

.design-detail-header {
  position: sticky;
  top: 0;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 36rpx;
  background: var(--lm-background);
}

.design-detail-title {
  min-width: 0;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.5;
  word-break: break-all;
}

.design-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--lm-soft);
}

.design-detail-content {
  padding: 0 36rpx 24rpx;
}

.design-detail-photo {
  display: block;
  width: 100%;
  margin-bottom: 24rpx;
  border-radius: 28rpx;
  background: var(--lm-soft);
}

.design-detail-missing {
  min-height: 360rpx;
  margin-bottom: 24rpx;
}

.design-detail-section {
  margin: 28rpx 0;
  color: var(--lm-muted);
  font-size: 28rpx;
  line-height: 1.8;
}

.design-detail-section-title {
  margin-bottom: 10rpx;
  color: var(--lm-text);
  font-weight: 600;
}

.design-unavailable {
  background: var(--lm-soft);
  padding: 24rpx;
  border-radius: 20rpx;
  font-size: 27rpx;
  line-height: 1.7;
}

.design-detail-actions {
  position: sticky;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 24rpx 36rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--lm-background);
}

.design-detail-actions t-button {
  flex: 1;
  min-width: 0;
}

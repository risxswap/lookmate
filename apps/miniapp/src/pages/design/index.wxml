<view class="page">
  <view wx:if="{{error}}" class="error">{{error}}<view class="link" bindtap="load">重新加载</view>
  </view>
  <view class="tabs">
    <view class="tab {{mode==='HAIRSTYLE'?'active':''}}" data-id="HAIRSTYLE" bindtap="mode">发型设计</view>
    <view class="tab {{mode==='OUTFIT'?'active':''}}" data-id="OUTFIT" bindtap="mode">穿搭设计</view>
    <view class="tab {{mode==='OVERALL'?'active':''}}" data-id="OVERALL" bindtap="mode">整体设计</view>
  </view>
  <view class="card">
    <view class="title">{{mode==='HAIRSTYLE'?'找到适合你的发型':mode==='OUTFIT'?'让灵感走进衣橱':'打造完整形象'}}</view>
    <view class="muted">{{mode==='OVERALL'?'结合你的照片、偏好和衣物，设计发型与穿搭。':'可以先选参考，也可以直接填写自己的想法。'}}</view>
    <t-button theme="primary" bind:tap="create">开始设计</t-button>
  </view>
  <block wx:if="{{mode!=='OVERALL'}}">
    <view class="card">
      <view class="row between">
        <view>只看收藏</view>
        <switch checked="{{scope==='favorites'}}" bindchange="favoriteScope"/>
      </view>
      <view wx:if="{{mode==='HAIRSTYLE'}}" class="row">
        <picker wx:for="{{filterRows}}" wx:key="key" range="{{item.values}}" data-id="{{item.key}}" bindchange="filter">
          <view class="pill">{{item.label}}筛选</view>
        </picker>
      </view>
      <block wx:else>
        <label class="label">场景</label>
        <input class="input" value="{{occasion}}" data-id="occasion" bindinput="field" placeholder="如 通勤"/>
        <label class="label">风格</label>
        <input class="input" value="{{style}}" data-id="style" bindinput="field" placeholder="如 简约"/>
        <t-button bind:tap="load">筛选</t-button>
      </block>
    </view>
    <view class="muted">共 {{total}} 个参考</view>
    <view wx:if="{{!items.length && !busy}}" class="empty">没有符合条件的参考，试试其他筛选。</view>
    <view class="grid">
      <view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="detail">
        <image src="{{item.cover}}" class="photo" mode="aspectFill"/>
        <view class="label">{{item.name}}</view>
        <view class="muted">{{item.favorited?'已收藏':''}} {{item.availability==='UNAVAILABLE'?'暂不可用':''}}</view>
      </view>
    </view>
    <t-button wx:if="{{hasMore}}" loading="{{busy}}" bind:tap="more">加载更多</t-button>
  </block>
  <view wx:if="{{detail}}" class="detail">
    <view class="row between">
      <view class="subtitle">{{detail.name}}</view>
      <t-button bind:tap="close" variant="text">关闭</t-button>
    </view>
    <image wx:for="{{detailImages}}" wx:key="*this" class="reference" src="{{item}}" mode="widthFix" data-url="{{item}}" bindtap="preview"/>
    <view class="card">
      <view>{{detail.description}}</view>
      <view>{{detail.careAdvice}}</view>
      <view>{{detail.styling.palette}}</view>
      <view>{{detail.styling.silhouette}}</view>
      <view>{{detail.styling.wearing}}</view>
    </view>
    <view class="actions">
      <t-button bind:tap="favorite" disabled="{{busy}}">{{detail.favorited?'取消收藏':'收藏参考'}}</t-button>
      <t-button theme="primary" data-reference="true" bind:tap="create" disabled="{{detail.availability!=='AVAILABLE'}}">使用此参考</t-button>
    </view>
  </view>
</view>

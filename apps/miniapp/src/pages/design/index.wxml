<view class="page design-page">
  <view class="design-segments">
    <t-button t-class="lm-custom-root design-segment {{mode==='HAIRSTYLE'?'is-selected':''}}" variant="text" hover-class="tap-feedback" data-id="HAIRSTYLE" bind:tap="mode" disabled="{{busy}}" aria-label="{{mode==='HAIRSTYLE'?'发型，已选中':'发型'}}">发型</t-button>
    <t-button t-class="lm-custom-root design-segment {{mode==='OUTFIT'?'is-selected':''}}" variant="text" hover-class="tap-feedback" data-id="OUTFIT" bind:tap="mode" disabled="{{busy}}" aria-label="{{mode==='OUTFIT'?'穿搭，已选中':'穿搭'}}">穿搭</t-button>
    <t-button t-class="lm-custom-root design-segment {{mode==='OVERALL'?'is-selected':''}}" variant="text" hover-class="tap-feedback" data-id="OVERALL" bind:tap="mode" disabled="{{busy}}" aria-label="{{mode==='OVERALL'?'整体，已选中':'整体'}}">整体</t-button>
  </view>

  <t-button class="lm-button lm-button--primary design-start" t-class="lm-button__root design-start-root" theme="primary" variant="base" size="large" block bind:tap="create">{{mode==='HAIRSTYLE'?'开始发型设计':mode==='OUTFIT'?'开始穿搭设计':'开始整体设计'}}<image slot="suffix" class="design-action-icon" src="/assets/icons/arrow-up-right-light.png" aria-hidden="true"/></t-button>
  <view wx:if="{{mode==='OVERALL'}}" class="design-start-note">同时设计发型和穿搭</view>

  <block wx:if="{{mode!=='OVERALL'}}">
    <view class="design-section-head">
      <view class="design-section-title">{{mode==='HAIRSTYLE'?'发型参考':'穿搭灵感'}}</view>
      <view class="design-tools">
        <t-button t-class="lm-custom-root design-filter-trigger {{filtersOpen || filterSummary?'is-selected':''}}" variant="text" hover-class="tap-feedback" bind:tap="toggleFilters" aria-label="{{filtersOpen?'收起参考筛选':'展开参考筛选'}}"><view class="lm-custom-content design-tool-content">
          <image class="design-small-icon" src="/assets/icons/filter.png" aria-hidden="true"/>
          {{filtersOpen?'收起':'筛选'}}
        </view></t-button>
        <t-button t-class="lm-custom-root design-collection {{scope==='favorites'?'is-selected':''}}" variant="text" hover-class="tap-feedback" bind:tap="favoriteScope" disabled="{{busy}}" aria-label="{{scope==='favorites'?'仅显示收藏，点击查看全部参考':'只看收藏参考'}}"><view class="lm-custom-content design-tool-content">
          <image class="design-small-icon" src="/assets/icons/heart.png" aria-hidden="true"/>
          {{scope==='favorites'?'仅收藏':'收藏'}}
        </view></t-button>
      </view>
    </view>
    <view wx:if="{{filterSummary}}" class="design-filter-summary">已选条件 {{filterSummary}}</view>
    <view wx:if="{{filtersOpen}}" class="design-filters">
      <view wx:if="{{mode==='HAIRSTYLE'}}" class="design-filter-pickers">
        <picker wx:for="{{filterRows}}" wx:key="key" range="{{item.values}}" value="{{item.selected}}" data-id="{{item.key}}" bindchange="filter" disabled="{{busy}}">
          <view class="design-picker"><text class="design-picker-label">{{item.label}}</text><text>{{item.values[item.selected]}} ▾</text></view>
        </picker>
      </view>
      <block wx:else>
        <label class="label">场景</label>
        <input class="input" value="{{occasion}}" data-id="occasion" bindinput="field" placeholder="如 通勤" disabled="{{busy}}"/>
        <label class="label">风格</label>
        <input class="input" value="{{style}}" data-id="style" bindinput="field" placeholder="如 简约" disabled="{{busy}}"/>
        <t-button class="lm-button lm-button--primary" t-class="lm-button__root" theme="primary" variant="base" size="large" block bind:tap="applyFilters" loading="{{busy}}" disabled="{{busy}}">应用筛选</t-button>
      </block>
    </view>
    <view wx:if="{{error}}" class="error">{{error}}<view class="link" bindtap="load">重新加载</view></view>
    <view wx:if="{{imageWarning}}" class="muted">{{imageWarning}}<view class="link" bindtap="retryImages">重试图片</view></view>
    <view wx:if="{{busy && !items.length}}" class="design-list-meta">加载中</view>
    <view wx:if="{{!items.length && !busy && !error}}" class="design-empty">
      <block wx:if="{{scope==='favorites'}}">
        <view>{{filterSummary?'没有符合条件的收藏':'还没有收藏的参考'}}</view>
        <view class="design-empty-note">{{filterSummary?'调整筛选，或点击「仅收藏」查看全部。':'点击「仅收藏」查看全部参考。'}}</view>
      </block>
      <block wx:elif="{{filterSummary}}">
        <view>没有符合条件的参考</view>
        <view class="design-empty-note">换个筛选条件试试。</view>
      </block>
      <view wx:else>{{mode==='HAIRSTYLE'?'暂无发型参考':'暂无穿搭灵感'}}</view>
    </view>
    <view wx:if="{{items.length}}" class="design-grid {{mode==='OUTFIT'?'design-grid--outfit':''}}">
      <t-button t-class="lm-custom-root design-reference" variant="text" block hover-class="tap-feedback" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bind:tap="detail"><view class="lm-custom-content design-reference-content">
        <view class="design-picture">
          <image wx:if="{{item.cover}}" src="{{item.cover}}" class="design-photo" mode="aspectFill" lazy-load data-id="{{item.id}}" data-cover="{{item.cover}}" data-mode="{{mode}}" binderror="imageError" aria-hidden="true"/>
          <view wx:else class="image-placeholder design-photo"><image class="design-empty-icon" src="/assets/icons/image.png"/><text>暂无参考图</text></view>
          <view wx:if="{{item.favorited}}" class="design-saved" aria-label="已收藏"><image class="design-small-icon" src="/assets/icons/heart.png" aria-hidden="true"/></view>
        </view>
        <view class="design-reference-caption">
          <view class="design-reference-name">{{item.name}}</view>
          <view wx:if="{{item.availability==='UNAVAILABLE'}}" class="design-reference-meta">暂不可用</view>
          <view wx:elif="{{mode==='OUTFIT' && item.primaryOccasion}}" class="design-reference-meta">{{item.primaryOccasion}}</view>
        </view>
      </view></t-button>
    </view>
    <view wx:if="{{items.length}}" class="design-list-meta">共 {{total}} 个参考{{busy?' · 加载中':''}}</view>
    <t-button class="lm-button lm-button--text" t-class="lm-button__root" theme="default" variant="text" size="medium" block wx:if="{{hasMore}}" loading="{{busy}}" bind:tap="more" disabled="{{busy}}">加载更多</t-button>
  </block>
  <view wx:elif="{{error}}" class="error">{{error}}<view class="link" bindtap="load">重新加载</view></view>
  <block wx:if="{{mode==='OVERALL' && !busy}}">
    <view wx:for="{{overallExamples}}" wx:for-item="gender" wx:key="*this" class="design-overall-example">
      <image wx:if="{{gender==='FEMALE'}}" class="design-overall-example-image" src="/assets/overall-design-example.jpg" mode="widthFix" aria-label="女款发型近景和全身穿搭示例"/>
      <image wx:else class="design-overall-example-image" src="/assets/overall-design-example-male.jpg" mode="widthFix" aria-label="男款发型近景和全身穿搭示例"/>
      <view class="design-overall-example-caption">AI 生成示例</view>
    </view>
  </block>

  <view wx:if="{{detail}}" class="design-detail">
    <view class="design-detail-header">
      <view class="design-detail-title">{{detail.name}}</view>
      <t-button t-class="lm-custom-root design-close" variant="text" hover-class="tap-feedback" bind:tap="close" aria-label="关闭参考详情"><view class="lm-custom-content design-close-content"><image src="/assets/icons/close.png" class="design-action-icon"/></view></t-button>
    </view>
    <scroll-view class="design-detail-scroll" scroll-y>
      <view class="design-detail-content">
        <view wx:if="{{error}}" class="error">{{error}}</view>
        <view wx:if="{{detailImageWarning}}" class="muted">{{detailImageWarning}}<view class="link" bindtap="retryImages">重试图片</view></view>
        <image wx:for="{{detailImages}}" wx:key="*this" class="design-detail-photo" src="{{item}}" mode="widthFix" data-url="{{item}}" bindtap="preview"/>
        <view wx:if="{{!detailImages.length}}" class="image-placeholder design-detail-missing"><image class="design-empty-icon" src="/assets/icons/image.png"/><text>{{detailImageWarning?'参考图片暂未加载':'暂无参考图'}}</text></view>
        <view wx:if="{{detail.availability==='UNAVAILABLE'}}" class="design-unavailable">这份参考暂不可用，可以继续浏览其他风格。</view>
        <view wx:if="{{detail.description}}" class="design-detail-section"><view class="design-detail-section-title">造型介绍</view><view>{{detail.description}}</view></view>
        <view wx:if="{{detail.careAdvice}}" class="design-detail-section"><view class="design-detail-section-title">日常打理</view><view>{{detail.careAdvice}}</view></view>
        <block wx:if="{{detail.styling}}">
          <view wx:if="{{detail.styling.palette}}" class="design-detail-section"><view class="design-detail-section-title">配色</view><view>{{detail.styling.palette}}</view></view>
          <view wx:if="{{detail.styling.silhouette}}" class="design-detail-section"><view class="design-detail-section-title">轮廓</view><view>{{detail.styling.silhouette}}</view></view>
          <view wx:if="{{detail.styling.wearing}}" class="design-detail-section"><view class="design-detail-section-title">穿着建议</view><view>{{detail.styling.wearing}}</view></view>
        </block>
      </view>
    </scroll-view>
    <view class="design-detail-actions">
      <t-button class="lm-button lm-button--primary" t-class="lm-button__root" theme="primary" variant="base" size="large" block data-reference="true" bind:tap="create" disabled="{{busy || detail.availability!=='AVAILABLE'}}">使用此参考</t-button>
      <t-button class="lm-button lm-button--outline" t-class="lm-button__root" theme="default" variant="outline" size="medium" block bind:tap="favorite" disabled="{{busy}}">{{detail.favorited?'取消收藏':'收藏参考'}}</t-button>
    </view>
  </view>
</view>

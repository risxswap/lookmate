<view aria-hidden="{{!!detail}}">
  <t-navbar t-class="lm-tab-navbar {{detail?'design-title-covered':''}}" title="设计" fixed placeholder animation="{{false}}"/>
</view>
<view class="page design-page">
  <view class="design-toolbar">
    <view class="design-segments">
      <t-button t-class="lm-custom-root design-segment {{mode==='HAIRSTYLE'?'is-selected':''}}" variant="text" hover-class="tap-feedback" data-id="HAIRSTYLE" bind:tap="mode" disabled="{{busy}}" aria-label="{{mode==='HAIRSTYLE'?'发型，已选中':'发型'}}">发型</t-button>
      <t-button t-class="lm-custom-root design-segment {{mode==='OUTFIT'?'is-selected':''}}" variant="text" hover-class="tap-feedback" data-id="OUTFIT" bind:tap="mode" disabled="{{busy}}" aria-label="{{mode==='OUTFIT'?'穿搭，已选中':'穿搭'}}">穿搭</t-button>
      <t-button t-class="lm-custom-root design-segment {{mode==='OVERALL'?'is-selected':''}}" variant="text" hover-class="tap-feedback" data-id="OVERALL" bind:tap="mode" disabled="{{busy}}" aria-label="{{mode==='OVERALL'?'整体，已选中':'整体'}}">整体</t-button>
    </view>
    <t-button t-class="lm-custom-root design-start" variant="text" hover-class="tap-feedback" bind:tap="create" aria-label="{{mode==='HAIRSTYLE'?'开始发型设计':mode==='OUTFIT'?'开始穿搭设计':'开始整体设计'}}">
      <view class="lm-custom-content design-start-pill"><text>开始设计</text><image class="design-small-icon" src="/assets/icons/arrow-up-right.png" aria-hidden="true"/></view>
    </t-button>
  </view>

  <view class="design-section-head">
    <view class="design-section-title">{{mode==='HAIRSTYLE'?'发型参考':mode==='OUTFIT'?'穿搭灵感':'整体造型'}}</view>
    <view wx:if="{{mode==='OVERALL' && overallExamples.length>1}}" class="design-example-options">
      <t-button wx:for="{{overallExamples}}" wx:key="*this" t-class="lm-custom-root design-example-option {{overallExampleGender===item?'is-selected':''}}" variant="text" hover-class="tap-feedback" data-id="{{item}}" bind:tap="selectOverallExample" aria-label="{{overallExampleImages[item].label+'示例'+(overallExampleGender===item?'，已选中':'')}}">
        <view class="design-example-option-label">{{overallExampleImages[item].label}}</view>
      </t-button>
    </view>
    <view wx:if="{{mode!=='OVERALL'}}" class="design-tools">
      <t-button t-class="lm-custom-root design-filter-trigger {{filtersOpen || filterSummary?'is-selected':''}}" variant="text" hover-class="tap-feedback" bind:tap="toggleFilters" aria-label="{{filtersOpen?'收起参考筛选':'展开参考筛选'}}">
        <view class="lm-custom-content design-tool-content"><image class="design-small-icon" src="/assets/icons/filter.png" aria-hidden="true"/><text>{{filtersOpen?'收起':'筛选'}}</text></view>
      </t-button>
      <t-button t-class="lm-custom-root design-collection {{scope==='favorites'?'is-selected':''}}" variant="text" hover-class="tap-feedback" bind:tap="favoriteScope" disabled="{{busy}}" aria-label="{{scope==='favorites'?'只看收藏，已选中，再点查看全部参考':'只看收藏参考'}}">
        <view class="lm-custom-content design-tool-content"><image class="design-small-icon" src="/assets/icons/heart.png" aria-hidden="true"/><text>只看收藏</text></view>
      </t-button>
    </view>
  </view>

  <block wx:if="{{mode!=='OVERALL'}}">
    <view wx:if="{{filterSummary}}" class="design-filter-summary">已选条件 {{filterSummary}}</view>
    <view wx:if="{{filtersOpen}}" class="design-filters">
      <block wx:for="{{filterGroups}}" wx:key="key" wx:for-item="group" wx:for-index="groupIndex">
        <view wx:if="{{groupIndex===0}}" class="design-filter-options">
          <t-button wx:for="{{group.options}}" wx:key="value" wx:for-item="option" wx:for-index="optionIndex"
            t-class="lm-custom-root design-filter-option {{group.selected===optionIndex?'is-selected':''}}"
            variant="text" hover-class="tap-feedback" data-id="{{group.key}}" data-index="{{optionIndex}}" bind:tap="filter" disabled="{{busy}}"
            aria-label="{{group.label+'，'+option.label+(group.selected===optionIndex?'，已选中':'')}}">
            <view class="lm-custom-content design-filter-chip">{{option.label}}</view>
          </t-button>
        </view>
        <picker wx:else range="{{group.options}}" range-key="label" value="{{group.selected}}" data-id="{{group.key}}" bindchange="filter" disabled="{{busy}}" aria-label="{{group.label+'，'+group.options[group.selected].label}}">
          <view class="design-picker"><text>{{group.label}}</text><text>{{group.options[group.selected].label}} ▾</text></view>
        </picker>
      </block>
    </view>
    <view wx:if="{{error}}" class="error">{{error}}<view class="link" bindtap="load">重新加载</view></view>
    <view wx:if="{{imageWarning}}" class="muted">{{imageWarning}}<view class="link" bindtap="retryImages">重试图片</view></view>
    <view wx:if="{{busy && !items.length}}" class="design-list-meta">加载中</view>
    <view wx:if="{{!items.length && !busy && !error}}" class="design-empty">
      <block wx:if="{{scope==='favorites'}}">
        <view>{{filterSummary?'没有符合条件的收藏':'还没有收藏的参考'}}</view>
        <view class="design-empty-note">{{filterSummary?'调整筛选，或关闭「只看收藏」查看全部。':'关闭「只看收藏」即可查看全部参考。'}}</view>
      </block>
      <block wx:elif="{{filterSummary}}">
        <view>没有符合条件的参考</view>
        <view class="design-empty-note">换个筛选条件试试。</view>
      </block>
      <view wx:else>{{mode==='HAIRSTYLE'?'暂无发型参考':'暂无穿搭灵感'}}</view>
    </view>
    <view wx:if="{{items.length}}" class="design-grid {{mode==='OUTFIT'?'design-grid--outfit':''}}">
      <t-button t-class="lm-custom-root design-reference" variant="text" block hover-class="tap-feedback" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bind:tap="detail" aria-label="{{item.name+(item.favorited?'，已收藏':'')+(item.availability==='UNAVAILABLE'?'，暂不可用':'')}}"><view class="lm-custom-content design-reference-content">
        <view class="design-picture">
          <image wx:if="{{item.cover}}" src="{{item.cover}}" class="design-photo" mode="aspectFill" lazy-load data-id="{{item.id}}" data-cover="{{item.cover}}" data-mode="{{mode}}" binderror="imageError" aria-hidden="true"/>
          <view wx:else class="image-placeholder design-photo"><image class="design-empty-icon" src="/assets/icons/image.png"/><text>暂无参考图</text></view>
          <view wx:if="{{item.favorited}}" class="design-saved" aria-label="已收藏"><image class="design-small-icon" src="/assets/icons/heart.png" aria-hidden="true"/></view>
        </view>
        <view class="design-reference-caption">
          <view class="design-reference-name">{{item.name}}</view>
          <view wx:if="{{item.availability==='UNAVAILABLE'}}" class="design-reference-meta">暂不可用</view>
          <view wx:elif="{{item.metaLabel}}" class="design-reference-meta">{{item.metaLabel}}</view>
        </view>
      </view></t-button>
    </view>
    <view wx:if="{{items.length}}" class="design-list-meta">共 {{total}} 个参考{{busy?' · 加载中':''}}</view>
    <t-button class="lm-button lm-button--text" t-class="lm-button__root" theme="default" variant="text" size="medium" block wx:if="{{hasMore}}" loading="{{busy}}" bind:tap="more" disabled="{{busy}}">加载更多</t-button>
  </block>
  <block wx:else>
    <view class="design-start-note">用一张本人照片和衣橱里的衣物，同时设计发型和穿搭，生成全身造型效果图。</view>
    <view wx:if="{{error}}" class="design-example-warning">
      <text>暂时无法按个人资料匹配示例。</text>
      <t-button t-class="lm-custom-root design-retry-images" variant="text" bind:tap="load" disabled="{{busy}}">重新加载</t-button>
    </view>
    <t-button wx:if="{{overallExamples.length}}" t-class="lm-custom-root design-overall-example" variant="text" block hover-class="design-example-pressed" bind:tap="previewOverallExample" aria-label="{{'查看'+overallExampleImages[overallExampleGender].label+'大图，AI 生成的发型近景与全身穿搭示例'}}">
      <view class="lm-custom-content">
        <image class="design-overall-example-image" src="{{overallExampleImages[overallExampleGender].src}}" mode="aspectFit" aria-hidden="true"/>
        <view class="design-overall-example-caption">
          <text>{{overallExampleImages[overallExampleGender].label}} · AI 生成示例</text>
          <view class="design-example-zoom"><text>查看大图</text><image class="design-small-icon" src="/assets/icons/arrow-up-right.png" aria-hidden="true"/></view>
        </view>
      </view>
    </t-button>
    <view wx:elif="{{busy}}" class="design-example-loading">正在读取造型示例…</view>
  </block>

  <view wx:if="{{detail}}" class="design-detail">
    <t-navbar t-class="lm-tab-navbar" title="设计" fixed="{{false}}" animation="{{false}}"/>
    <view class="design-detail-header">
      <view class="design-detail-heading">
        <view class="design-detail-title">{{detail.name}}</view>
        <view wx:if="{{detailAttributes}}" class="design-detail-attributes">{{detailAttributes}}</view>
      </view>
      <t-button t-class="lm-custom-root design-close" variant="text" hover-class="tap-feedback" bind:tap="close" aria-label="关闭参考详情"><view class="lm-custom-content design-close-content"><image src="/assets/icons/close.png" class="design-action-icon" aria-hidden="true"/></view></t-button>
    </view>
    <scroll-view class="design-detail-scroll" scroll-y>
      <view class="design-detail-content">
        <view wx:if="{{error}}" class="error">{{error}}</view>
        <view class="design-detail-gallery {{mode==='OUTFIT'?'design-detail-gallery--outfit':detailImages.length>1?'design-detail-gallery--angles':''}}">
          <view class="design-main-area">
            <t-button wx:if="{{detailImages.length}}" t-class="lm-custom-root design-main-preview" variant="text" block hover-class="tap-feedback" data-url="{{detailImages[detailImageIndex].url}}" bind:tap="preview" aria-label="{{'查看'+detail.name+(mode==='HAIRSTYLE'?detailImages[detailImageIndex].label:'')+'大图'}}">
              <view class="lm-custom-content design-main-frame">
                <image class="design-main-photo" mode="aspectFit" src="{{detailImages[detailImageIndex].url}}" data-id="{{detailImages[detailImageIndex].id}}" data-url="{{detailImages[detailImageIndex].url}}" binderror="detailImageError" aria-hidden="true"/>
                <text class="design-zoom">查看大图</text>
              </view>
            </t-button>
            <view wx:else class="image-placeholder design-detail-missing">
              <image class="design-empty-icon" src="/assets/icons/image.png" aria-hidden="true"/>
              <text>{{detailImagesLoading?'正在加载参考图…':detailImageWarning?'参考图片暂未加载':'暂无参考图'}}</text>
            </view>
            <t-button t-class="lm-custom-root design-detail-favorite" variant="text" hover-class="tap-feedback" catch:tap="favorite" disabled="{{busy}}" aria-label="{{(detail.favorited?'取消收藏':'收藏')+(mode==='HAIRSTYLE'?'这款发型':'这套穿搭')}}">
              <view class="design-favorite-disc"><image class="design-favorite-icon" src="{{detail.favorited?'/assets/icons/heart-filled.png':'/assets/icons/heart.png'}}" mode="aspectFit" aria-hidden="true"/></view>
            </t-button>
          </view>
          <view wx:if="{{mode==='HAIRSTYLE' && detailImages.length>1}}" class="hair-angles">
            <t-button wx:for="{{detailImages}}" wx:key="id" data-id="{{item.id}}" bind:tap="selectDetailImage" t-class="lm-custom-root hair-angle {{detailImageIndex===index?'is-selected':''}}" variant="text" block hover-class="tap-feedback" aria-label="{{item.label+(detailImageIndex===index?'，已选中':'，点击切换')}}">
              <view class="lm-custom-content hair-angle-choice">
                <view class="hair-thumb-frame"><image class="hair-thumb" mode="aspectFill" src="{{item.url}}" data-id="{{item.id}}" data-url="{{item.url}}" binderror="detailImageError" aria-hidden="true"/></view>
                <text class="hair-angle-name">{{item.label}}</text>
              </view>
            </t-button>
          </view>
        </view>
        <view wx:if="{{detailImageWarning}}" class="design-image-warning">
          <text wx:if="{{detailImages.length}}">{{detailImageWarning}}</text>
          <t-button t-class="lm-custom-root design-retry-images" variant="text" hover-class="tap-feedback" bind:tap="retryImages" disabled="{{busy}}">重试图片</t-button>
        </view>
        <view wx:if="{{detail.availability==='UNAVAILABLE'}}" class="design-unavailable">这份参考暂不可用，可以继续浏览其他风格。</view>
        <view wx:if="{{detail.description}}" class="design-detail-section"><view class="design-detail-section-title">造型介绍</view><view>{{detail.description}}</view></view>
        <view wx:if="{{detail.careAdvice}}" class="design-detail-section"><view class="design-detail-section-title">日常打理</view><view>{{detail.careAdvice}}</view></view>
        <block wx:if="{{detail.styling}}">
          <view wx:if="{{detail.styling.palette}}" class="design-detail-section"><view class="design-detail-section-title">配色</view><view>{{detail.styling.palette}}</view></view>
          <view wx:if="{{detail.styling.silhouette}}" class="design-detail-section"><view class="design-detail-section-title">轮廓</view><view>{{detail.styling.silhouette}}</view></view>
          <view wx:if="{{detail.styling.wearing}}" class="design-detail-section"><view class="design-detail-section-title">穿着建议</view><view>{{detail.styling.wearing}}</view></view>
        </block>
      </view>
    </scroll-view>
    <view class="design-detail-actions">
      <t-button class="lm-button lm-button--primary" t-class="lm-button__root" theme="primary" variant="base" size="medium" block data-reference="true" bind:tap="create" disabled="{{busy || detail.availability!=='AVAILABLE'}}" aria-label="{{mode==='HAIRSTYLE'?'用这款发型':'用这套穿搭'}}">{{mode==='HAIRSTYLE'?'用这款发型':'用这套穿搭'}}</t-button>
    </view>
  </view>
</view>

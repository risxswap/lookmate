.current-measurement {
  padding: 16rpx 28rpx 28rpx;
  background: var(--lm-soft);
}

.current-measurement-header,
.history-detail-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.current-measurement-header {
  min-height: 44px;
}

.current-measurement-header .section-title {
  flex: 1;
  margin: 0;
}

.current-count {
  color: var(--lm-muted);
  font-size: 26rpx;
}

.history-menu,
.history-close {
  display: block;
  flex: 0 0 44px;
  width: 44px;
}

.t-button.history-menu__root {
  color: var(--lm-primary);
  font-size: 22px;
  font-weight: 700;
  line-height: 1;
}

.t-button.history-close__root {
  color: var(--lm-primary);
  font-size: 28rpx;
}

.current-measurement-fields {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}

.current-measurement-field {
  flex: 1 1 132rpx;
  min-width: 0;
}

.current-measurement-value {
  color: var(--lm-primary);
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.2;
  overflow-wrap: break-word;
}

.current-measurement-unit {
  font-size: 26rpx;
  font-weight: 500;
}

.history-list-header {
  margin: 36rpx 0 16rpx;
}

.history-list {
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  background: var(--lm-surface);
}

.history-row + .history-row {
  border-top: 1rpx solid var(--lm-border);
}

.history-row-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 18rpx 0;
  color: var(--lm-text);
  text-align: left;
}

.history-row-text {
  min-width: 0;
}

.history-date {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
  overflow-wrap: break-word;
}

.history-summary {
  margin-top: 4rpx;
}

.history-chevron {
  flex: 0 0 20rpx;
  width: 20rpx;
  height: 20rpx;
}

.history-detail {
  display: flex;
  box-sizing: border-box;
  flex-direction: column;
  height: 78vh;
  max-height: 1120rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  overflow: hidden;
  background: var(--lm-surface);
  color: var(--lm-text);
}

.history-detail-header {
  flex-shrink: 0;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--lm-border);
}

.history-detail-heading {
  flex: 1;
  min-width: 0;
}

.history-detail-title {
  font-size: 36rpx;
  font-weight: 600;
}

.history-detail-scroll {
  flex: 1 1 0;
  height: 0;
  min-height: 0;
}

.history-detail-group {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--lm-border);
}

.history-detail-group:last-child {
  border-bottom: 0;
}

.history-detail-group-title {
  font-size: 28rpx;
  font-weight: 600;
}

.history-fields {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx 24rpx;
  margin-top: 10rpx;
}

.history-field {
  display: flex;
  flex-direction: column;
  min-width: 0;
  font-size: 28rpx;
}

.history-field-value {
  font-weight: 500;
  overflow-wrap: break-word;
}

.history-detail-footer {
  flex-shrink: 0;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--lm-border);
}

.history-detail-error {
  margin: 0 0 12rpx;
  padding: 12rpx 16rpx;
}

.lm-button.history-detail-apply {
  margin: 0;
}

.page.design-detail {
  max-width: 540px;
  margin: 0 auto;
  padding: 4px 18px calc(28px + env(safe-area-inset-bottom));
  overflow-wrap: anywhere;
}

.heading-top,
.heading-meta,
.heading-tools,
.heading-context,
.action-chip,
.more-mark,
.photo-toolbar,
.photo-switch,
.inline-content,
.section-head,
.piece-heading,
.accordion-row,
.accordion-trailing {
  display: flex;
  align-items: center;
}

.heading-top,
.photo-toolbar,
.section-head,
.accordion-row {
  justify-content: space-between;
  gap: 8px;
}

.detail-heading {
  margin-bottom: 14px;
}

.heading-top {
  min-height: 32px;
  margin-bottom: 2px;
}

.heading-meta {
  min-width: 0;
  flex-wrap: wrap;
  gap: 2px 10px;
  font-size: 12px;
  line-height: 1.4;
}

.design-type {
  color: var(--lm-primary);
  font-weight: 650;
}

.design-date,
.heading-context,
.figure-count,
.reference-label,
.status-note {
  color: var(--lm-muted);
}

.heading-tools,
.photo-switch,
.inline-content,
.accordion-trailing {
  flex: none;
}

.heading-tools {
  gap: 2px;
}

.t-button.heading-action,
.t-button.more-action,
.t-button.detail-link {
  min-width: 44px;
  color: var(--lm-primary);
}

.action-chip,
.more-mark {
  box-sizing: border-box;
  justify-content: center;
  min-height: 30px;
  border: 1rpx solid var(--lm-border);
  background: var(--lm-surface);
}

.action-chip {
  gap: 4px;
  padding: 3px 9px;
  border-radius: 16px;
  font-size: 13px;
}

.action-chip--saved,
.completed-status {
  background: var(--lm-soft);
  color: var(--lm-primary);
}

.action-icon {
  width: 16px;
  height: 16px;
}

.more-mark {
  width: 32px;
  margin: auto;
  gap: 2px;
  border-radius: 16px;
}

.more-mark view {
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: var(--lm-primary);
}

.design-title,
.advice-title {
  color: var(--lm-text);
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", serif;
  font-weight: 600;
}

.design-title {
  font-size: 26px;
  line-height: 1.32;
  text-wrap: balance;
}

.heading-context {
  flex-wrap: wrap;
  gap: 4px 9px;
  margin-top: 7px;
  font-size: 13px;
  line-height: 1.55;
}

.completed-status,
.piece-category {
  display: inline-block;
  padding: 2px 7px;
  border-radius: 5px;
  font-size: 12px;
  line-height: 1.4;
}

.task-state,
.detail-error,
.effect-state {
  border-radius: 12px;
}

.task-state,
.detail-error {
  padding: 14px;
  margin-bottom: 14px;
}

.task-state {
  background: var(--lm-soft);
}

.task-state--failed,
.detail-error,
.detail-notice--warning {
  color: var(--lm-error);
  background: var(--lm-error-background);
}

.task-state--unknown {
  background: #f4efe1;
}

.state-title,
.detail-label,
.piece-name,
.hair-name {
  font-weight: 600;
}

.state-title {
  font-size: 17px;
}

.task-state .detail-copy,
.status-note {
  margin-top: 5px;
}

.stages {
  display: flex;
  gap: 4px;
  margin-top: 13px;
}

.stage {
  flex: 1;
  min-width: 0;
  font-size: 12px;
  color: var(--lm-muted);
}

.stage-track {
  height: 3px;
  margin-bottom: 5px;
  border-radius: 2px;
  background: #c9d0c6;
}

.stage--done .stage-track {
  background: #7e9581;
}

.stage--current {
  color: var(--lm-primary);
  font-weight: 650;
}

.stage--current .stage-track {
  background: var(--lm-primary);
}

.status-note {
  font-size: 13px;
}

.pending-state:not(:first-child) {
  margin-top: 14px;
  padding-top: 12px;
  border-top: 1rpx solid var(--lm-border);
}

.detail-error,
.detail-choices,
.effect-state {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px 10px;
}

.detail-error {
  justify-content: space-between;
}

.detail-choices {
  margin-top: 10px;
}

.detail-choices .lm-button {
  width: auto;
  margin: 0;
}

.photo-section {
  margin: 0 0 16px;
  padding-top: 3px;
  border-top: 1rpx solid var(--lm-border);
}

.photo-toolbar {
  min-height: 44px;
  margin-bottom: 5px;
}

.photo-switch {
  gap: 2px;
}

.photo-option,
.photo-title {
  font-size: 14px;
  font-weight: 600;
}

.photo-option {
  display: block;
  box-sizing: border-box;
  min-width: 60px;
  padding: 5px 10px;
  border-radius: 16px;
  color: var(--lm-muted);
  line-height: 20px;
  text-align: center;
}

.photo-option.is-selected {
  background: var(--lm-primary);
  color: var(--lm-surface);
}

.t-button.detail-link {
  font-size: 13px;
  font-weight: 550;
}

.inline-content,
.accordion-trailing {
  gap: 4px;
}

.small-icon {
  width: 13px;
  height: 13px;
}

.effect-frame {
  border-radius: 14px;
  overflow: hidden;
  background: var(--lm-image-background);
}

.t-button.effect-preview,
.t-button.reference-preview {
  display: block;
  border-radius: 0;
  line-height: 0;
}

.result-image {
  display: block;
  width: 100%;
}

.effect-state {
  justify-content: center;
  min-height: 92px;
  padding: 8px 12px;
  background: var(--lm-image-background);
  color: var(--lm-muted);
  font-size: 14px;
}

.state-image {
  width: 22px;
  height: 22px;
}

.detail-notices {
  display: grid;
  gap: 6px;
  margin: 12px 0;
}

.detail-notice {
  padding: 8px 10px;
  border-radius: 7px;
  background: var(--lm-soft);
  color: var(--lm-muted);
  font-size: 13px;
  line-height: 1.55;
}

.detail-notice.detail-notice--warning {
  color: var(--lm-error);
  background: var(--lm-error-background);
}

.design-summary {
  padding-left: 12px;
  margin: 16px 0;
  border-left: 3px solid #9aaf98;
  font-size: 16px;
  line-height: 1.65;
  white-space: pre-line;
}

.original-only {
  margin-top: -4px;
}

.advice-section,
.appendix {
  margin-top: 20px;
}

.advice-title {
  font-size: 20px;
  line-height: 1.45;
}

.advice-body,
.appendix {
  border: 1rpx solid var(--lm-border);
  border-radius: 12px;
  background: var(--lm-surface);
}

.advice-body {
  margin-top: 8px;
  padding: 0 14px;
}

.detail-copy {
  min-width: 0;
  font-size: 15px;
  line-height: 1.65;
  white-space: pre-line;
}

.advice-intro {
  margin-top: 5px;
}

.outfit-piece,
.hair-name,
.hair-point {
  padding: 12px 0;
}

.outfit-piece + .outfit-piece,
.hair-point + .hair-point,
.hair-name + .hair-point,
.appendix-part + .appendix-part {
  border-top: 1rpx solid var(--lm-border);
}

.piece-heading {
  align-items: baseline;
  flex-wrap: wrap;
  gap: 3px 8px;
}

.piece-name,
.hair-name {
  font-size: 16px;
}

.piece-category {
  color: var(--lm-muted);
  background: var(--lm-background);
}

.outfit-piece .detail-copy {
  margin-top: 4px;
}

.hair-point {
  display: grid;
  grid-template-columns: 60px minmax(0, 1fr);
  gap: 10px;
}

.hair-label {
  color: var(--lm-muted);
  font-size: 14px;
  line-height: 1.75;
}

.appendix {
  padding: 0 14px;
}

.t-button.accordion {
  min-height: 50px;
  text-align: left;
}

.accordion-row {
  padding: 5px 0;
  font-size: 16px;
  font-weight: 600;
}

.figure-count {
  font-size: 13px;
  font-weight: 400;
}

.chevron {
  width: 16px;
  height: 16px;
  transform: rotate(90deg);
}

.chevron--open {
  transform: rotate(-90deg);
}

.appendix-content {
  padding-bottom: 14px;
}

.explanation + .explanation {
  margin-top: 12px;
}

.detail-label {
  margin-bottom: 3px;
  font-size: 14px;
}

.reference-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.reference-image {
  display: block;
  width: 100%;
  height: 104px;
  border-radius: 8px;
  background: var(--lm-image-background);
}

.reference-placeholder {
  display: grid;
  place-items: center;
  color: var(--lm-muted);
  font-size: 12px;
}

.reference-label {
  margin-top: 4px;
  font-size: 12px;
  line-height: 1.5;
}

.detail-sheet {
  box-sizing: border-box;
  padding: 8px 18px 12px;
  border-radius: 18px 18px 0 0;
  background: var(--lm-surface);
}

.detail-sheet .section-head {
  padding-bottom: 5px;
  margin-bottom: 4px;
  border-bottom: 1rpx solid var(--lm-border);
}

.t-button.menu-item {
  min-height: 50px;
  text-align: left;
  font-size: 16px;
}

.record-actions {
  border-top: 1rpx solid var(--lm-border);
}

.t-button.menu-item--danger {
  color: var(--lm-error);
}

@media (max-width: 350px) {
  .page.design-detail {
    padding-right: 14px;
    padding-left: 14px;
  }
  .design-title {
    font-size: 24px;
  }
  .reference-image {
    height: 88px;
  }
}

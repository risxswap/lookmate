.design-detail {
  max-width: 540px;
  margin: 0 auto;
}

.detail-heading {
  margin-bottom: 20rpx;
}

.detail-heading .title {
  margin: 0 0 6rpx;
  line-height: 1.28;
  text-wrap: balance;
}

.task-state,
.effect-state {
  padding: 18rpx 22rpx;
  margin-bottom: 18rpx;
  border-radius: 20rpx;
  background: var(--lm-soft);
}

.task-state--failed {
  background: var(--lm-error-background);
}

.task-state--failed .task-state-title {
  color: var(--lm-error);
}

.task-state-title {
  font-size: 28rpx;
  font-weight: 600;
}

.task-state .detail-copy,
.task-state .muted {
  margin-top: 6rpx;
}

.task-state-title ~ .pending-state {
  margin-top: 12rpx;
}

.detail-choices,
.effect-tools,
.effect-operations {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.detail-choices {
  margin-top: 12rpx;
}

.detail-choices .lm-button {
  flex: 0 1 auto;
  width: auto;
  margin: 0;
}

.effect-frame {
  overflow: hidden;
  border-radius: 24rpx;
  background: var(--lm-image-background);
}

.effect-preview,
.details-toggle {
  display: block;
}

.t-button.effect-preview__root {
  border-radius: 0;
}

.result-image {
  display: block;
  width: 100%;
}

.effect-state,
.detail-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  color: var(--lm-muted);
  font-size: 26rpx;
}

.detail-error {
  color: var(--lm-error);
}

.effect-tools {
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin: 14rpx 0 20rpx;
}

.effect-operations {
  margin-left: auto;
}

.detail-inline {
  width: auto;
  margin: 0;
  --lm-button-padding-horizontal: 18rpx;
}

.more-trigger {
  min-width: 44px;
  --lm-button-padding-horizontal: 14rpx;
  --td-button-small-font: 600 32rpx / 1 -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.detail-notices {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.detail-notice {
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: var(--lm-soft);
  color: var(--lm-muted);
  font-size: 25rpx;
  overflow-wrap: anywhere;
}

.detail-notice--warning {
  background: var(--lm-error-background);
  color: var(--lm-error);
}

.design-summary {
  margin: 0 0 22rpx;
  font-size: 30rpx;
  line-height: 1.65;
  white-space: pre-line;
  overflow-wrap: anywhere;
}

.advice-card {
  padding: 20rpx 24rpx;
  margin-bottom: 18rpx;
}

.advice-card .section-title {
  margin: 0 0 10rpx;
}

.detail-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.detail-section-header .section-title {
  margin: 0;
}

.detail-copy {
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-line;
  overflow-wrap: anywhere;
}

.wearing-advice {
  margin-top: 12rpx;
}

.outfit-piece,
.hair-point,
.explanation {
  padding-top: 12rpx;
  margin-top: 12rpx;
  border-top: 1px solid var(--lm-border);
}

.piece-heading {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 4rpx 10rpx;
  margin-bottom: 4rpx;
}

.piece-name,
.hair-name,
.detail-label {
  font-size: 28rpx;
  font-weight: 600;
  overflow-wrap: anywhere;
}

.hair-point {
  display: grid;
  grid-template-columns: 108rpx minmax(0, 1fr);
  gap: 12rpx;
}

.hair-label {
  line-height: 1.72;
}

.detail-label {
  margin-bottom: 4rpx;
}

.reference-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.reference-image {
  display: flex;
  width: 100%;
  height: 150rpx;
  border-radius: 14rpx;
  background: var(--lm-image-background);
  font-size: 22rpx;
}

.reference-label {
  margin-top: 6rpx;
  line-height: 1.4;
}

.detail-sheet {
  box-sizing: border-box;
  padding: 20rpx 32rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: var(--lm-surface);
  color: var(--lm-text);
}

.detail-menu-item {
  margin: 12rpx 0 0;
}

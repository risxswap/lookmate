.design-create {
  padding: 24rpx 32rpx calc(148rpx + env(safe-area-inset-bottom));
}

.design-form-section {
  margin-bottom: 24rpx;
}

.design-form-heading,
.design-reference-row,
.design-review-heading,
.design-review-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.design-form-heading,
.design-review-heading {
  justify-content: space-between;
}

.design-heading-action {
  display: flex;
  flex: 0 0 auto;
  justify-content: flex-end;
  margin-left: auto;
  text-align: right;
}

.design-form-title {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
}

.design-link {
  flex-shrink: 0;
}

.t-button.design-link__root {
  min-width: 44px;
  min-height: 44px;
  margin: 0;
  padding: 0 8rpx;
}

.design-chevron {
  flex: 0 0 auto;
  width: 26rpx;
  height: 26rpx;
}

.design-chevron--open {
  transform: rotate(90deg);
}

.person-photo-scroll {
  display: block;
  width: 100%;
}

.person-photo-track {
  display: flex;
  gap: 16rpx;
}

.person-photo {
  position: relative;
  box-sizing: border-box;
  flex: 0 0 calc((100% - 16rpx) / 2);
  min-width: 0;
  border-radius: 22rpx;
  overflow: hidden;
}

.person-photo-track--overflow .person-photo {
  flex-basis: calc((100% - 96rpx) / 2);
}

.person-photo--selected::after {
  position: absolute;
  inset: 0;
  pointer-events: none;
  content: '';
  border: 4rpx solid var(--lm-primary);
  border-radius: inherit;
}

.person-photo-image {
  width: 100%;
  height: 298rpx;
}

.person-photo-label {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  max-width: calc(100% - 24rpx);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  background: var(--lm-surface);
  color: var(--lm-text);
  font-size: 22rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.person-photo-check {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  display: grid;
  width: 42rpx;
  height: 42rpx;
  place-items: center;
  border: 2rpx solid var(--lm-surface);
  border-radius: 50%;
  background: var(--lm-primary);
  color: var(--lm-surface);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
}

.design-photo-empty {
  padding: 24rpx;
  border-radius: 18rpx;
  background: var(--lm-soft);
}

.design-reference-card {
  padding: 16rpx 20rpx;
  border-radius: 22rpx;
  background: var(--lm-soft);
}

.design-reference-thumb {
  flex-shrink: 0;
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
}

.design-reference-copy {
  flex: 1;
  min-width: 0;
}

.design-reference-label {
  color: var(--lm-muted);
  font-size: 24rpx;
}

.design-reference-name {
  font-size: 32rpx;
  font-weight: 600;
  overflow-wrap: break-word;
}

.design-reference-warning {
  margin-top: 12rpx;
  color: var(--lm-muted);
  font-size: 25rpx;
  overflow-wrap: break-word;
}

.design-idea-label {
  display: block;
  margin-bottom: 12rpx;
}

.design-idea,
.design-input {
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: transparent;
  font-size: max(14px, 28rpx);
}

.design-idea {
  height: 104rpx;
  min-height: 104rpx;
}

.design-input {
  min-height: 44px;
}

.design-paired-fields {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  margin-top: 14rpx;
}

.design-field-label {
  display: block;
  margin-bottom: 6rpx;
  font-size: max(14px, 26rpx);
  font-weight: 500;
}

.design-accordion {
  border-top: 1rpx solid var(--lm-border);
  border-bottom: 1rpx solid var(--lm-border);
}

.design-accordion + .design-accordion {
  border-top: 0;
}

.design-accordion-heading {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 6rpx;
  text-align: left;
  color: var(--lm-text);
  font-size: 30rpx;
  font-weight: 600;
}

.design-accordion-summary {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--lm-muted);
  font-size: 24rpx;
  font-weight: 400;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.design-accordion-body {
  padding: 6rpx 6rpx 16rpx;
}

.design-switch-row,
.design-draft-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-height: 44px;
  margin-top: 12rpx;
}

.design-dress-summary,
.design-dress-selected {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 6rpx 14rpx;
}

.design-dress-thumb {
  box-sizing: border-box;
  width: 76rpx;
  height: 76rpx;
  border-radius: 12rpx;
}

.design-dress-chip {
  max-width: 100%;
  --td-button-small-height: 44px;
}

.design-dress-grid {
  gap: 16rpx;
  margin-top: 12rpx;
}

.design-dress-cell {
  padding: 6rpx;
  border: 2rpx solid var(--lm-border);
  border-radius: 18rpx;
  font-size: 26rpx;
  text-align: left;
}

.design-dress-cell--selected {
  border-color: var(--lm-primary);
  background: var(--lm-soft);
}

.design-dress-image {
  width: 100%;
  height: 204rpx;
  border-radius: 14rpx;
}

.design-dress-name {
  padding: 8rpx;
  color: var(--lm-text);
  overflow-wrap: break-word;
}

.overall-dress-section {
  margin: 16rpx 0 24rpx;
  padding: 16rpx 20rpx 20rpx;
  border: 1rpx solid var(--lm-border);
  border-radius: 20rpx;
  background: var(--lm-surface);
}

.overall-dress-auto {
  color: var(--lm-muted);
  font-size: max(13px, 26rpx);
}

.overall-dress-track,
.overall-dress-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.overall-dress-item {
  flex: none;
  max-width: 80%;
  padding-right: 12rpx;
  color: var(--lm-text);
  font-size: max(14px, 26rpx);
}

.overall-dress-item .design-dress-thumb {
  flex: none;
}

.overall-dress-item text {
  overflow-wrap: anywhere;
}

.overall-dress-choices {
  padding: 20rpx 32rpx;
}

.overall-dress-sheet .design-review-action {
  padding-bottom: 14rpx;
}

.design-pending .actions {
  margin-bottom: 0;
}

.design-form-error {
  margin-top: 12rpx;
  color: var(--lm-error);
  font-size: 26rpx;
  overflow-wrap: break-word;
}

.design-check-body {
  padding: 20rpx 0 0;
}

.design-override {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 44px;
  font-size: 27rpx;
  overflow-wrap: break-word;
}

.design-fixed-action {
  position: fixed;
  z-index: 2;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 14rpx 32rpx calc(14rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--lm-border);
  background: var(--lm-background);
}

.design-fixed-action .lm-button,
.design-review-action .lm-button {
  margin: 0;
}

.design-review {
  display: flex;
  flex-direction: column;
  height: 65vh;
  max-height: 980rpx;
  overflow: hidden;
  border-radius: 28rpx 28rpx 0 0;
  background: var(--lm-surface);
  color: var(--lm-text);
}

.design-review-heading {
  flex-shrink: 0;
  padding: 12rpx 32rpx;
  border-bottom: 1rpx solid var(--lm-border);
}

.design-review-scroll {
  flex: 1 1 auto;
  height: 0;
  min-height: 0;
}

.design-review-body {
  padding: 0 32rpx 18rpx;
}

.design-review-item,
.design-review-text,
.design-review-note {
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--lm-border);
  overflow-wrap: break-word;
}

.design-review-thumb {
  flex-shrink: 0;
  width: 84rpx;
  height: 84rpx;
  border-radius: 14rpx;
}

.design-review-action {
  flex-shrink: 0;
  padding: 14rpx 32rpx calc(14rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--lm-border);
}

.design-create--overall .design-photo-panel {
  padding: 16rpx 20rpx;
  margin-bottom: 34rpx;
  border: 1rpx solid var(--lm-border);
  border-radius: 26rpx;
  background: var(--lm-surface);
}

.overall-current-row,
.overall-change-photo {
  display: flex;
  align-items: center;
}

.overall-current-row {
  gap: 22rpx;
  text-align: left;
}

.overall-current-thumb {
  flex: 0 0 96rpx;
  width: 96rpx;
  height: 128rpx;
  border-radius: 12rpx;
  background: var(--lm-image-background);
}

.overall-current-copy {
  flex: 1;
  min-width: 0;
}

.overall-photo-label {
  color: var(--lm-muted);
  font-size: max(12px, 23rpx);
}

.overall-photo-name {
  margin-top: 5rpx;
  color: var(--lm-text);
  font-size: max(16px, 32rpx);
  font-weight: 600;
}

.overall-change-photo {
  gap: 3rpx;
  color: var(--lm-primary);
  font-size: max(14px, 27rpx);
  font-weight: 550;
}

.overall-photo-hint {
  margin: 4rpx 0 18rpx;
  color: var(--lm-muted);
  font-size: max(13px, 25rpx);
  line-height: 1.5;
}

.overall-photo-add {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  min-height: 160rpx;
  border: 2rpx dashed #afbdaf;
  border-radius: 18rpx;
  background: var(--lm-soft);
  color: var(--lm-primary);
  font-size: 29rpx;
  font-weight: 600;
}

.overall-photo-icon {
  display: grid;
  place-items: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: var(--lm-surface);
}

.design-create--overall .person-photo {
  background: var(--lm-image-background);
}

.design-create--overall .person-photo::before {
  display: block;
  padding-top: 133.333%;
  content: '';
}

.design-create--overall .person-photo-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.person-photo-track--single .person-photo {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 22rpx;
  padding-right: 68rpx;
  background: var(--lm-soft);
}

.person-photo-track--single .person-photo::before {
  display: none;
}

.person-photo-track--single .person-photo-image {
  position: static;
  flex: 0 0 120rpx;
  width: 120rpx;
  height: 160rpx;
}

.person-photo-track--single .person-photo-label {
  position: static;
  padding: 0;
  border-radius: 0;
  background: transparent;
  font-size: 27rpx;
  font-weight: 500;
}

.overall-direction-heading {
  display: flex;
  align-items: baseline;
  color: var(--lm-text);
  font: 600 22px / 1.4 "Songti SC", "STSong", "Noto Serif CJK SC", serif;
}

.overall-direction-heading .overall-optional {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.overall-preference,
.overall-note-label {
  margin-top: 18rpx;
}

.overall-choice-list {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.overall-choice-face {
  padding: 13rpx 2rpx;
  border: 1rpx solid var(--lm-border);
  border-radius: 16rpx;
  color: var(--lm-text);
  background: var(--lm-surface);
  font-size: max(14px, 26rpx);
  line-height: 1.4;
  text-align: center;
}

.overall-choice-face--selected {
  border-color: var(--lm-primary);
  color: var(--lm-surface);
  background: var(--lm-primary);
  font-weight: 600;
}

.overall-custom-input {
  margin: 6rpx 0 4rpx;
}

.overall-optional {
  margin-left: 16rpx;
  color: var(--lm-muted);
  font-size: 25rpx;
  font-weight: 400;
}

.design-create--overall .design-idea,
.design-create--overall .design-input {
  background: var(--lm-surface);
}

.design-review--overall .design-review-item {
  gap: 22rpx;
  margin-top: 20rpx;
  padding: 16rpx;
  border: 0;
  border-radius: 18rpx;
  background: var(--lm-soft);
}

.design-review--overall .design-review-thumb {
  width: 88rpx;
  height: 110rpx;
}

.design-review--overall .design-review-action {
  padding-bottom: 14rpx;
}

.design-review--overall .design-review-text {
  display: grid;
  grid-template-columns: 128rpx minmax(0, 1fr);
  column-gap: 14rpx;
  padding-block: 20rpx;
}

.design-review--overall .design-review-text > view {
  grid-column: 2;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.design-review--overall .design-review-text > .muted {
  grid-column: 1;
  grid-row: 1;
}

@media (max-width: 350px) {
  .design-create {
    padding-right: 26rpx;
    padding-left: 26rpx;
  }

  .design-fixed-action {
    padding-right: 26rpx;
    padding-left: 26rpx;
  }
}

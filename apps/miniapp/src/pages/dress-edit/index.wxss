.page.dress-editor {
  padding: 10px 34rpx calc(90px + env(safe-area-inset-bottom));
}

.page.dress-editor--feedback {
  padding-bottom: calc(154px + env(safe-area-inset-bottom));
}

.editor-section + .editor-section {
  margin-top: 22px;
}

.editor-heading,
.heading-with-count,
.load-error,
.field-row,
.upload-content,
.photo-add-pill {
  display: flex;
  align-items: center;
}

.editor-heading,
.load-error {
  justify-content: space-between;
  gap: 12px;
}

.editor-heading {
  min-height: 32px;
  margin-bottom: 8px;
}

.heading-with-count {
  gap: 8px;
}

.editor-title {
  color: var(--lm-text);
  font-size: 18px;
  font-weight: 600;
}

.section-note,
.upload-hint,
.photo-hint {
  color: var(--lm-muted);
  font-size: 12px;
}

.photo-add-pill {
  gap: 4px;
  padding: 6px 10px;
  border-radius: 99px;
  background: var(--lm-soft);
  color: var(--lm-primary);
  font-size: 13px;
  font-weight: 500;
}

.photo-add-pill image {
  width: 14px;
  height: 14px;
}

.upload-content {
  justify-content: center;
  gap: 14px;
  min-height: 94px;
  padding: 12px;
  border: 1px dashed #acb9a8;
  border-radius: 14px;
  background: var(--lm-surface);
  text-align: left;
}

.upload-icon {
  display: grid;
  flex: none;
  width: 46px;
  height: 46px;
  place-items: center;
  border-radius: 50%;
  background: var(--lm-soft);
}

.upload-icon image {
  width: 24px;
  height: 24px;
}

.upload-title {
  margin-bottom: 3px;
  color: var(--lm-primary);
  font-size: 16px;
  font-weight: 600;
}

.photo-hint {
  margin-top: 7px;
}

.field-panel {
  padding: 0 14px;
  border-radius: 14px;
  background: var(--lm-surface);
}

.field-block + .field-block {
  border-top: 1rpx solid var(--lm-border);
}

.field-row {
  gap: 12px;
  min-height: 51px;
}

.field-label {
  flex: 0 0 4.5em;
  color: var(--lm-text);
  font-size: 15px;
  font-weight: 500;
}

.row-input,
.category-value {
  flex: 1;
  min-width: 0;
  color: var(--lm-text);
  font-size: 15px;
}

.row-input {
  height: 44px;
}

.field-placeholder {
  color: var(--lm-muted);
}

.category-chevron {
  width: 14px;
  height: 14px;
  flex: none;
}

.stacked-field {
  padding: 10px 0;
}

.notes-input {
  box-sizing: border-box;
  width: 100%;
  height: 62px;
  padding: 5px 0;
  margin-top: 2px;
  font-size: 15px;
  color: var(--lm-text);
  line-height: 1.5;
}

.field-error,
.save-error {
  color: var(--lm-error);
  font-size: 13px;
  line-height: 1.5;
  overflow-wrap: break-word;
}

.field-block .field-error {
  padding-bottom: 8px;
}

.editor-section > .field-error {
  margin-top: 6px;
}

.t-button.load-retry {
  flex-shrink: 0;
  color: var(--lm-primary);
  font-size: 14px;
}

.dress-save-bar {
  position: fixed;
  z-index: 2;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 8px 34rpx calc(8px + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--lm-border);
  background: var(--lm-surface);
}

.dress-save-bar .lm-button {
  margin: 0;
  --td-button-border-radius: 14px;
}

.save-error-scroll {
  max-height: 60px;
  margin-bottom: 5px;
}

.save-error {
  padding: 2px 0;
}

.photo-scroll {
  display: block;
  width: 100%;
}

.photo-track {
  display: flex;
  gap: 24rpx;
}

.dress-photo {
  position: relative;
  flex: 0 0 calc((100% - 24rpx) / 2);
  min-width: 0;
}

.photo-track--overflow .dress-photo {
  flex-basis: calc((100% - 72rpx) / 2);
}

.season-options {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 6px;
  margin-top: 5px;
}

.season-option {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3px;
  min-width: 0;
  min-height: 44px;
  border-radius: 9px;
  background: var(--lm-background);
  color: var(--lm-primary);
  font-size: 14px;
  white-space: nowrap;
}

.season-checkbox {
  flex-shrink: 0;
  width: 22px;
  height: 22px;
  transform: scale(.75);
}

.photo-cover-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 4rpx 12rpx;
  border-radius: 99rpx;
  background: var(--lm-primary);
  color: var(--lm-surface);
  font-size: 24rpx;
  pointer-events: none;
}

.photo-menu {
  position: absolute;
  top: 0;
  right: 0;
  display: block;
  width: 44px;
  height: 44px;
  --td-button-small-height: 44px;
  --td-button-default-color: var(--lm-primary);
}

.t-button.photo-menu__root {
  padding: 0;
  margin: 0;
}

.photo-menu-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: var(--lm-surface);
  color: var(--lm-primary);
  font-size: 20px;
  font-weight: 700;
  line-height: 1;
  box-shadow: 0 2rpx 8rpx rgba(36, 59, 50, .12);
}

.recognition-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 8rpx 12rpx 8rpx 20rpx;
  border-radius: 16rpx;
  background: var(--lm-soft);
  color: var(--lm-primary);
  font-size: 26rpx;
}

.recognition-status-copy {
  flex: 1;
  min-width: 0;
  overflow-wrap: break-word;
}

.t-button.recognition-action {
  flex-shrink: 0;
  min-height: 44px;
  margin: 0;
  padding: 0 16rpx;
}

.recognition-sheet {
  display: flex;
  flex-direction: column;
  height: 78vh;
  max-height: 1120rpx;
  overflow: hidden;
  border-radius: 28rpx 28rpx 0 0;
  background: var(--lm-surface);
  color: var(--lm-text);
}

.recognition-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--lm-border);
}

.recognition-thumb {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: var(--lm-image-background);
}

.recognition-title {
  font-size: 34rpx;
  font-weight: 600;
}

.recognition-body {
  flex: 1;
  height: 0;
  min-height: 0;
}

.recognition-content {
  padding: 12rpx 28rpx 24rpx;
}

.recognition-feature {
  padding: 20rpx 0;
  font-size: 28rpx;
  overflow-wrap: break-word;
}

.recognition-feature + .recognition-feature {
  border-top: 1rpx solid var(--lm-border);
}

.recognition-feature-label {
  margin-bottom: 6rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.recognition-revised {
  margin-left: 12rpx;
  color: var(--lm-muted);
  font-size: 24rpx;
  font-weight: 400;
}

.recognition-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.recognition-picker image {
  flex-shrink: 0;
  width: 24rpx;
  height: 24rpx;
}

.recognition-footer {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  border-top: 1rpx solid var(--lm-border);
}

.recognition-footer .lm-button {
  flex: 1;
  width: auto;
  margin: 0;
}

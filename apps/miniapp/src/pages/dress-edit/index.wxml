<view wx:if="{{loadFailed}}" class="page dress-editor">
  <view class="error load-error">
    <text>{{error}}</text>
    <t-button t-class="lm-custom-root load-retry" variant="text" size="small" bind:tap="load" disabled="{{busy}}">重新加载</t-button>
  </view>
</view>
<view wx:else class="page dress-editor {{error?'dress-editor--feedback':''}}">
  <view id="dress-photos" class="editor-section">
    <view class="editor-heading">
      <view class="heading-with-count"><text class="editor-title">衣物照片</text><text class="section-note" aria-label="已选 {{images.length}} 张">{{images.length}}{{images.length > 8 ? ' 张' : ' / 8'}}</text></view>
      <t-button wx:if="{{images.length && images.length < 8}}" t-class="lm-custom-root" variant="text" hover-class="tap-feedback" bind:tap="add" disabled="{{busy}}">
        <view class="photo-add-pill"><image src="/assets/icons/plus.png" aria-hidden="true"/>添加照片</view>
      </t-button>
    </view>
    <t-button wx:if="{{!images.length}}" t-class="lm-custom-root upload-target" variant="text" block hover-class="tap-feedback" bind:tap="add" disabled="{{busy}}" aria-label="添加照片，拍照或从相册选择，第一张用作封面">
      <view class="lm-custom-content upload-content">
        <view class="upload-icon"><image src="/assets/icons/camera.png" aria-hidden="true"/></view>
        <view><view class="upload-title">添加照片</view><view class="upload-hint">拍照或从相册选择，第一张作为封面</view></view>
      </view>
    </t-button>
    <scroll-view wx:if="{{images.length}}" class="photo-scroll" enhanced scroll-x="{{images.length > 2}}" show-scrollbar="{{false}}">
      <view class="photo-track {{images.length > 2 ? 'photo-track--overflow' : ''}}">
        <view wx:for="{{images}}" wx:key="fileId" class="dress-photo">
          <view data-id="{{item.fileId}}" bindtap="preview" aria-role="button" aria-label="查看第 {{index + 1}} 张衣物照片大图">
            <image class="photo" src="{{item.url}}" mode="aspectFill" aria-hidden="true"/>
          </view>
          <text wx:if="{{index === 0}}" class="photo-cover-badge">封面</text>
          <view class="photo-menu">
            <t-button t-class="photo-menu__root" theme="default" variant="text" size="small" shape="circle" aria-label="第 {{index + 1}} 张照片的更多操作" data-id="{{item.fileId}}" bind:tap="photoMenu" disabled="{{busy}}">
              <text class="photo-menu-icon" aria-hidden="true">···</text>
            </t-button>
          </view>
        </view>
      </view>
    </scroll-view>
    <view wx:if="{{fieldErrors.photos}}" class="field-error">{{fieldErrors.photos}}</view>
    <view wx:if="{{images.length}}" class="photo-hint">点击照片查看大图<text wx:if="{{images.length > 2}}"> · 可左右滑动</text></view>
    <view wx:if="{{recognitionText && dress.recognition.status !== 'SUCCEEDED'}}" class="recognition-status">
      <view class="recognition-status-copy">
        <view>{{recognitionText}}</view>
        <view wx:if="{{dress.recognition.errorMessage}}" class="muted">{{dress.recognition.errorMessage}}</view>
      </view>
      <t-button wx:if="{{dress.recognition.status === 'FAILED' || dress.recognition.status === 'UNKNOWN'}}" t-class="recognition-action" variant="text" size="small" bind:tap="retry" disabled="{{busy}}">重新识别</t-button>
      <t-button wx:else t-class="recognition-action" variant="text" size="small" bind:tap="refreshRecognition" disabled="{{busy}}">刷新状态</t-button>
    </view>
  </view>
  <view class="editor-section">
    <view class="editor-heading"><text class="editor-title">基本信息</text><text class="section-note">必填</text></view>
    <view class="field-panel">
      <view id="dress-name" class="field-block">
        <view class="field-row">
          <label class="field-label" for="dress-name-input">衣物名称</label>
          <input id="dress-name-input" class="row-input" value="{{name}}" data-key="name" bindinput="field" disabled="{{busy}}" maxlength="100" placeholder="如：双排扣风衣" placeholder-class="field-placeholder" cursor-spacing="88"/>
        </view>
        <view wx:if="{{fieldErrors.name}}" class="field-error">{{fieldErrors.name}}</view>
      </view>
      <view id="dress-category" class="field-block">
        <picker disabled="{{busy}}" range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="category" aria-label="选择衣物分类，当前{{categoryName}}">
          <view class="field-row">
            <text class="field-label">分类</text>
            <text class="category-value {{!categoryId?'field-placeholder':''}}">{{categoryName}}</text>
            <image class="category-chevron" src="/assets/icons/chevron-right.png" aria-hidden="true"/>
          </view>
        </picker>
        <view wx:if="{{fieldErrors.category}}" class="field-error">{{fieldErrors.category}}</view>
      </view>
    </view>
  </view>
  <view class="editor-section">
    <view class="editor-heading"><text class="editor-title">补充信息</text><text class="section-note">选填</text></view>
    <view class="field-panel">
      <view class="field-block">
        <view class="field-row">
          <label class="field-label" for="dress-color-input">颜色</label>
          <input id="dress-color-input" class="row-input" value="{{color}}" data-key="color" bindinput="field" disabled="{{busy}}" maxlength="100" placeholder="如：卡其色" placeholder-class="field-placeholder" cursor-spacing="88"/>
        </view>
      </view>
      <view class="field-block stacked-field">
        <view class="field-label">季节</view>
        <checkbox-group class="season-options" bindchange="season" aria-label="适用季节，可多选">
          <label wx:for="{{seasonOptions}}" wx:key="value" class="season-option">
            <checkbox disabled="{{busy}}" class="season-checkbox" value="{{item.value}}" checked="{{item.checked}}" color="#304f40"/><text>{{item.label}}</text>
          </label>
        </checkbox-group>
      </view>
      <view class="field-block stacked-field">
        <label class="field-label" for="dress-notes-input">备注</label>
        <textarea id="dress-notes-input" class="notes-input" value="{{notes}}" data-key="notes" bindinput="field" disabled="{{busy}}" maxlength="1000" placeholder="记下材质、版型或穿着感受" placeholder-class="field-placeholder" cursor-spacing="88"/>
      </view>
    </view>
  </view>
  <t-button wx:if="{{dress}}" class="lm-button lm-button--danger lm-button--text delete-dress" t-class="lm-button__root" theme="danger" variant="text" size="medium" block bind:tap="remove" disabled="{{busy}}">删除衣物</t-button>
  <view wx:if="{{!recognitionVisible}}" class="dress-save-bar">
    <scroll-view wx:if="{{error}}" scroll-y class="save-error-scroll"><view class="save-error">{{error}}</view></scroll-view>
    <t-button class="lm-button lm-button--primary" t-class="lm-button__root" theme="primary" variant="base" size="large" block bind:tap="save" loading="{{saving}}" disabled="{{busy}}">保存衣物</t-button>
  </view>
</view>

<t-popup visible="{{recognitionVisible}}" placement="bottom" prevent-scroll-through bind:visible-change="closeRecognition">
  <view wx:if="{{recognitionVisible}}" class="recognition-sheet">
    <view class="recognition-header">
      <image class="recognition-thumb" src="{{recognitionThumb}}" mode="aspectFill" aria-hidden="true"/>
      <view class="grow">
        <view class="recognition-title">{{recognitionEditing ? '修订识别结果' : '图片识别'}}</view>
        <view class="muted">第 {{recognitionPhotoNumber}} 张照片</view>
      </view>
      <t-button t-class="recognition-action" variant="text" size="small" bind:tap="closeRecognition" disabled="{{busy}}">关闭</t-button>
    </view>

    <scroll-view wx:if="{{!recognitionEditing}}" class="recognition-body" scroll-y>
      <view class="recognition-content">
        <view wx:if="{{recognitionRefreshNeeded}}" class="error">{{recognitionEditError}}</view>
        <view wx:for="{{features}}" wx:key="key" class="recognition-feature">
          <view class="recognition-feature-label">{{item.label}}<text wx:if="{{item.manual}}" class="recognition-revised">已修订</text></view>
          <view>{{item.text}}</view>
        </view>
      </view>
    </scroll-view>
    <scroll-view wx:else class="recognition-body" scroll-y>
      <view class="recognition-content">
        <view wx:if="{{recognitionEditError}}" class="error">{{recognitionEditError}}</view>
        <t-button wx:if="{{recognitionRefreshNeeded}}" t-class="recognition-action" variant="text" size="small" bind:tap="refreshRecognition" disabled="{{busy}}">刷新识别结果</t-button>
        <label class="label">修订项目</label>
        <picker range="{{featureChoices}}" range-key="label" value="{{featureIndex}}" bindchange="changeFeature" disabled="{{busy}}">
          <view class="input recognition-picker">{{featureChoices[featureIndex].label}}<image src="/assets/icons/chevron-right.png" mode="aspectFit" aria-hidden="true"/></view>
        </picker>
        <picker wx:if="{{featureKey === 'viewType'}}" range="{{viewOptions}}" value="{{viewIndex}}" bindchange="view" disabled="{{busy}}">
          <label class="label">拍摄视角</label>
          <view class="input recognition-picker">{{featureValue || '选择拍摄视角'}}<image src="/assets/icons/chevron-right.png" mode="aspectFit" aria-hidden="true"/></view>
        </picker>
        <block wx:elif="{{featureKey === 'details'}}">
          <view wx:for="{{detailFields}}" wx:key="key">
            <label class="label">{{item.label}}</label>
            <input class="input" value="{{detailValues[item.key]}}" data-id="{{item.key}}" bindinput="detailField" disabled="{{busy}}"/>
          </view>
        </block>
        <block wx:else>
          <label class="label">{{featureChoices[featureIndex].label}}</label>
          <textarea class="textarea" value="{{featureValue}}" data-key="featureValue" bindinput="field" disabled="{{busy}}" placeholder="{{featureKey === 'colors' || featureKey === 'styleTags' ? '多项用顿号分隔，留空可清除' : '留空可清除'}}"/>
        </block>
        <t-button wx:if="{{featureRevised}}" t-class="recognition-action" variant="text" size="small" data-reset="{{true}}" bind:tap="saveFeature" disabled="{{busy || recognitionRefreshNeeded}}">恢复 AI 内容</t-button>
      </view>
    </scroll-view>

    <view class="recognition-footer">
      <t-button wx:if="{{!recognitionEditing && recognitionRefreshNeeded}}" class="lm-button lm-button--primary" t-class="lm-button__root" theme="primary" block bind:tap="refreshRecognition" disabled="{{busy}}">刷新识别结果</t-button>
      <t-button wx:elif="{{!recognitionEditing}}" class="lm-button lm-button--primary" t-class="lm-button__root" theme="primary" block bind:tap="beginRecognitionEdit">修订</t-button>
      <block wx:else>
        <t-button class="lm-button" t-class="lm-button__root" variant="outline" block bind:tap="cancelRecognitionEdit" disabled="{{busy}}">返回结果</t-button>
        <t-button class="lm-button lm-button--primary" t-class="lm-button__root" theme="primary" block bind:tap="saveFeature" loading="{{busy}}" disabled="{{busy || recognitionRefreshNeeded}}">保存修订</t-button>
      </block>
    </view>
  </view>
</t-popup>

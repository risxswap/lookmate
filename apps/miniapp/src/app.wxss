page {
  --lm-background: #f7f6f2;
  --lm-surface: #fffefa;
  --lm-text: #243b32;
  --lm-primary: #304f40;
  --lm-primary-active: #244131;
  --lm-muted: #666f65;
  --lm-soft: #e9eee6;
  --lm-border: #e1e4da;
  --lm-image-background: #eeece5;
  --lm-error: #a1322e;
  --lm-error-background: #fff0ec;

  --td-brand-color: var(--lm-primary);
  --td-brand-color-active: var(--lm-primary-active);
  --td-brand-color-light: var(--lm-soft);
  --td-brand-color-disabled: #a9b6a7;
  --td-text-color-primary: var(--lm-text);
  --td-text-color-secondary: var(--lm-muted);
  --td-bg-color-page: var(--lm-background);
  --td-bg-color-container: var(--lm-surface);
  --td-button-border-radius: 20rpx;
  --td-button-border-width: 2rpx;
  --td-button-default-color: var(--lm-text);
  --td-button-default-bg-color: var(--lm-soft);
  --td-button-default-border-color: var(--lm-soft);
  --td-button-primary-color: var(--lm-surface);
  --td-button-medium-font: 500 28rpx / 44rpx -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  --td-radius-default: 24rpx;

  background: var(--lm-background);
  color: var(--lm-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
}

.page {
  box-sizing: border-box;
  padding: 32rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
}

.title {
  margin: 12rpx 0 32rpx;
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.35;
  overflow-wrap: break-word;
}

.subtitle,
.section-title {
  margin-bottom: 20rpx;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
}

.card {
  padding: 28rpx;
  margin-bottom: 24rpx;
  border-radius: 28rpx;
  background: var(--lm-surface);
}

.muted {
  color: var(--lm-muted);
  font-size: 26rpx;
  line-height: 1.65;
  overflow-wrap: break-word;
}

.error {
  padding: 24rpx;
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  background: var(--lm-error-background);
  color: var(--lm-error);
  font-size: 26rpx;
  line-height: 1.6;
  overflow-wrap: break-word;
}

.empty {
  padding: 64rpx 24rpx;
  text-align: center;
  color: var(--lm-muted);
  font-size: 28rpx;
  line-height: 1.7;
}

.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.between {
  justify-content: space-between;
}

.grow {
  flex: 1;
  min-width: 0;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
}

.photo {
  display: block;
  width: 100%;
  height: 360rpx;
  border-radius: 24rpx;
  background: var(--lm-image-background);
}

.image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 12rpx;
  background: var(--lm-image-background);
  color: var(--lm-muted);
  font-size: 24rpx;
}

.icon {
  display: block;
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.actions t-button {
  flex: 1;
  min-width: 0;
}

.label {
  display: block;
  margin: 20rpx 0 12rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.input,
.textarea {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  padding: 22rpx;
  border: 2rpx solid var(--lm-border);
  border-radius: 20rpx;
  background: var(--lm-surface);
  color: var(--lm-text);
  font-size: 30rpx;
}

.input {
  min-height: 88rpx;
}

.textarea {
  min-height: 180rpx;
  line-height: 1.6;
}

.pill {
  display: inline-block;
  padding: 10rpx 20rpx;
  margin: 8rpx;
  border-radius: 99rpx;
  background: var(--lm-soft);
  color: var(--lm-primary);
  font-size: 26rpx;
}

.tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.tab {
  flex: 1;
  min-width: 0;
  padding: 20rpx 12rpx;
  border-radius: 20rpx;
  background: var(--lm-soft);
  color: var(--lm-muted);
  font-size: 28rpx;
  line-height: 1.5;
  text-align: center;
}

.tab.active {
  background: var(--lm-primary);
  color: var(--lm-surface);
}

.link {
  display: inline-block;
  color: var(--lm-primary);
  font-size: 26rpx;
  line-height: 1.7;
}

.sticky-actions {
  position: sticky;
  bottom: 0;
  z-index: 2;
  padding: 20rpx 0 calc(20rpx + env(safe-area-inset-bottom));
  background: var(--lm-background);
}

button {
  font-size: 28rpx;
}

image {
  display: block;
}

t-button {
  min-height: 88rpx;
}

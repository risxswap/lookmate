page{background:#f5f7f4;color:#203c32;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:30rpx;--td-brand-color:#315c50;--td-brand-color-active:#24483e;--td-brand-color-light:#e9f0e8;--td-button-border-radius:20rpx;--td-radius-default:20rpx}
.page{padding:32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));box-sizing:border-box}.title{font-size:42rpx;font-weight:700;margin:12rpx 0 32rpx;line-height:1.35}.subtitle,.section-title{font-size:32rpx;font-weight:600;margin-bottom:20rpx}.card{background:#fff;border:1rpx solid #e0e8de;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx}.muted{color:#66776c;font-size:26rpx;line-height:1.65}.error{color:#a12c28;background:#fff0ee;padding:24rpx;border-radius:16rpx;margin-bottom:24rpx;line-height:1.5}.empty{padding:72rpx 24rpx;text-align:center;color:#66776c}.row{display:flex;align-items:center;gap:20rpx}.between{justify-content:space-between}.grow{flex:1;min-width:0}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx}.photo{width:100%;height:360rpx;border-radius:20rpx;background:#edf1eb}.actions{display:flex;gap:16rpx;flex-wrap:wrap;margin-top:24rpx}.actions t-button{flex:1}.label{display:block;margin:20rpx 0 12rpx;font-size:28rpx;font-weight:600}.input{box-sizing:border-box;width:100%;background:#f5f7f4;padding:22rpx;border-radius:14rpx;min-height:88rpx}.textarea{box-sizing:border-box;width:100%;background:#f5f7f4;padding:22rpx;border-radius:14rpx;min-height:180rpx}.pill{display:inline-block;background:#e9f0e8;color:#315c50;padding:10rpx 20rpx;border-radius:99rpx;margin:8rpx}.tabs{display:flex;gap:12rpx;margin-bottom:28rpx}.tab{flex:1;text-align:center;padding:20rpx 12rpx;background:#eaf0e8;border-radius:16rpx;font-size:28rpx}.tab.active{background:#315c50;color:#fff}.link{color:#315c50;text-decoration:underline}.sticky-actions{position:sticky;bottom:0;background:#f5f7f4;padding:20rpx 0 calc(20rpx + env(safe-area-inset-bottom));z-index:2}button{font-size:28rpx}image{display:block}t-button{min-height:88rpx}

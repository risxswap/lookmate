# Java properties 格式，不要使用 shell source；复制到 apps/server/.env.dev 后填写本地凭据。
spring.datasource.url=jdbc:mysql://127.0.0.1:3306/lookmate?serverTimezone=UTC&characterEncoding=UTF-8
spring.datasource.username=
spring.datasource.password=
spring.data.redis.host=127.0.0.1
spring.data.redis.port=6379
spring.data.redis.password=
spring.data.redis.database=1

# 七牛云、衣物识别和设计生成。填写凭据后重启；启用前完成供应商与预算验证。
lookmate.assets.access-key=
lookmate.assets.secret-key=
lookmate.assets.bucket=
lookmate.assets.download-domain=
lookmate.assets.upload-url=
lookmate.assets.token-seconds=600
lookmate.assets.access-seconds=300
lookmate.assets.pending-limit=100
lookmate.assets.user-pending-limit=20
lookmate.assets.cleanup-ms=60000
# Pause upload registration, recognition dispatch and asset cleanup (not a full deployment maintenance protocol).
lookmate.assets.maintenance=false
lookmate.jobs.enabled=true
lookmate.recognition.enabled=false
lookmate.recognition.api-key=
lookmate.recognition.provider=siliconflow
lookmate.recognition.protocol=openai-chat
lookmate.recognition.endpoint=https://api.siliconflow.cn/v1/chat/completions
lookmate.recognition.model=deepseek-ai/DeepSeek-V4.1-Flash
lookmate.recognition.timeout-seconds=120
lookmate.recognition.concurrency=1
lookmate.recognition.provider-concurrency=2
lookmate.recognition.max-images=10
lookmate.recognition.pending-limit=100
lookmate.recognition.user-pending-limit=20
lookmate.recognition.poll-ms=3000

# Design generation: keep disabled until both provider protocols and budgets have been verified.
lookmate.generation.enabled=false
lookmate.generation.budgets-verified=false
lookmate.generation.preview-secret=
lookmate.generation.plan-provider=siliconflow
lookmate.generation.plan-protocol=openai-chat
lookmate.generation.plan-endpoint=https://api.siliconflow.cn/v1/chat/completions
lookmate.generation.plan-model=deepseek-ai/DeepSeek-V4.1-Flash
lookmate.generation.plan-api-key=
lookmate.generation.image-provider=siliconflow
lookmate.generation.image-protocol=siliconflow-images
lookmate.generation.image-endpoint=https://api.siliconflow.cn/v1/images/generations
lookmate.generation.image-model=Kwai-Kolors/Kolors
lookmate.generation.image-api-key=
# siliconflow-images supports image_size, num_inference_steps, guidance_scale.
# Optional after verification: image-parameters.image_size=1024x1024
# openai-edits supports size, quality, background, output_format, output_compression,
# input_fidelity, response_format. Remove old protocol parameters when switching.
# siliconflow-images accepts ONE reference image: outfit/overall requests are unavailable.
# Protocol must be explicit when migrating old multipart configuration: openai-edits.
lookmate.generation.planning-max-images=0
lookmate.generation.image-max-images=0
lookmate.generation.max-input-bytes=0
lookmate.generation.max-text-chars=0
lookmate.generation.timeout-seconds=180
lookmate.generation.concurrency=2
lookmate.generation.pending-limit=100
lookmate.generation.wardrobe-scan-limit=500
lookmate.generation.candidate-target=24
lookmate.generation.history-limit=10
# Use a persistent host volume outside release directories. Never use an ephemeral container path.
lookmate.generation.staging-directory=./runtime/generation
lookmate.generation.min-free-bytes=104857600
# To retain older configurations, supply plan-credentials/image-credentials maps keyed by
# the exact endpoint + "|" + model (bracket-quoted map key in YAML). Values are secret credentials.
# Task snapshots contain endpoints/model identifiers/budgets only, never credentials.

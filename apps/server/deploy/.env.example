# 复制到稳定安装目录 server/.env，实际值不要提交。
COMPOSE_PROJECT_NAME=lookmate-server
LOOKMATE_NETWORK=lookmate
LOOKMATE_VERSION=CHANGE_ME
SERVER_IMAGE=eclipse-temurin:21.0.13_9-jre-jammy
SERVER_UID=10001
SERVER_GID=10001
SERVER_MEMORY_LIMIT=1536m
# 使用独立于 releases/<版本>/ 的绝对路径。
SERVER_CONFIG_FILE=/opt/lookmate/server/config/application.properties
SERVER_RUNTIME_DIR=/opt/lookmate/server/runtime
JAVA_TOOL_OPTIONS='-XX:MaxRAMPercentage=70.0 -XX:+ExitOnOutOfMemoryError'

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "启动后端",
      "type": "java",
      "request": "launch",
      "mainClass": "cc.riskswap.lookmate.LookmateApplication",
      "projectName": "server",
      "cwd": "${workspaceFolder}/apps/server",
      "args": "--spring.profiles.active=dev",
      "env": {
        "LOOKMATE_DEV_CONFIG": "${workspaceFolder}/.env.dev"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "启动前端",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/apps/web"
    },
    {
      "name": "数据迁移",
      "type": "node-terminal",
      "request": "launch",
      "command": "bash ops/migrate.sh migrate",
      "env": {
        "LOOKMATE_DEV_CONFIG": "${workspaceFolder}/.env.dev"
      },
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "启动 frp 隧道",
      "type": "node-terminal",
      "request": "launch",
      "command": "exec bash infra/frp/frp.sh client",
      "cwd": "${workspaceFolder}",
      "env": {
        "LOOKMATE_FRP_CONFIG": "${workspaceFolder}/infra/frp/.env"
      }
    }
  ]
}

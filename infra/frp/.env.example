# 复制为 .env；这是由 Bash 读取的可信本机配置，含空格或特殊字符的值使用单引号。
FRP_SERVER_ADDR=''
FRP_SERVER_PORT=7000
FRP_REMOTE_PORT=18080
FRP_TOKEN=''
FRP_LOCAL_IP=127.0.0.1
FRP_LOCAL_PORT=8080
FRP_PROXY_NAME=lookmate-dev
FRPC_BIN=frpc
# 可选：指定 PEM CA 文件以校验 frps 服务端证书；留空时只有加密和 token 认证。
FRP_TLS_CA_FILE=''
FRP_TLS_SERVER_NAME=''
# 服务端镜像固定版本；升级时同步本机二进制。
FRPS_IMAGE=ghcr.io/fatedier/frps:v0.71.1
FRP_BIND_IP=0.0.0.0
# 可选：证书和私钥放在 certs/，此处填容器内 /etc/frp/certs/... 路径。
FRP_TLS_CERT_FILE=''
FRP_TLS_KEY_FILE=''
# 已有宿主机 Nginx 的域名和证书路径；仅 nginx 命令需要。
FRP_DOMAIN=''
FRP_NGINX_CERT_FILE=''
FRP_NGINX_KEY_FILE=''
FRP_NGINX_READ_TIMEOUT=60s

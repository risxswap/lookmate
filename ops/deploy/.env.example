COMPOSE_PROJECT_NAME=lookmate-ops
LOOKMATE_NETWORK=lookmate
FLYWAY_IMAGE=redgate/flyway:12.4.0
FLYWAY_PLATFORM=linux/amd64
FLYWAY_URL='jdbc:mysql://lookmate-mysql:3306/lookmate?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true'
# 使用已存在并具有目标库迁移权限的账号，不使用 root。
FLYWAY_USER=lookmate
# 首次部署可对应 MYSQL_PASSWORD；如准备独立迁移账号则填其密码。
FLYWAY_PASSWORD=''
FLYWAY_CONNECT_RETRIES=10
